                331
              ],
              "elements": [
                {
                  "id": "p0330-b5-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "又四面偏室。"
                },
                {
                  "id": "p0330-b5-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "禮·月令",
                  "ref": "p0330-bk11"
                },
                {
                  "id": "p0330-b5-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "孟春，天子居靑陽左个。季春居右个。"
                },
                {
                  "id": "p0330-b5-e8",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0330-bk12"
                },
