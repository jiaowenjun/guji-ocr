              "elements": [
                {
                  "id": "p0330-b6-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "堂旁舍也。 又"
                },
                {
                  "id": "p0330-b6-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "禮·檀弓",
                  "ref": "p0330-bk13"
                },
                {
                  "id": "p0330-b6-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "有若曰：國君七个，遣車七乗。大夫五个，"
                }
              ]
            },
            {
              "id": "p0330-b6-l1",
              "ord": 1,
              "src": [
                366,
                395
              ],
              "elements": [
                {
                  "id": "p0330-b6-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "遣車五乗。"
                },
                {
                  "id": "p0330-b6-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0330-bk14"
                },
                {
                  "id": "p0330-b6-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "个謂所包遣奠牲體臂臑也。折爲七段五段，以七"
                }
              ]
            }
          ]
        },
        {
          "id": "p0330-b7",
          "ord": 7,
          "src": [
