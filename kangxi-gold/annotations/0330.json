                262
              ],
              "elements": [
                {
                  "id": "p0330-b4-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "曰一个。"
                },
                {
                  "id": "p0330-b4-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "左傳·昭三年",
                  "ref": "p0330-bk8"
                },
                {
                  "id": "p0330-b4-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "齊公孫竈卒。晏子曰：又弱一个焉。 又物"
                }
              ]
            }
          ]
        },
        {
          "id": "p0330-b5",
          "ord": 5,
          "src": [
