              "ord": 0,
              "src": [
                397,
                428
              ],
              "elements": [
                {
                  "id": "p0330-b7-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "乗五乗遣車載之。 又通作介。獨也，偏也。"
                },
                {
                  "id": "p0330-b7-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "莊子·養生主",
                  "ref": "p0330-bk15"
                },
                {
                  "id": "p0330-b7-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "是何人"
                }
              ]
            },
            {
              "id": "p0330-b7-l1",
              "ord": 1,
              "src": [
                429,
                461
              ],
              "elements": [
                {
                  "id": "p0330-b7-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "惡乎介也。天之生是使獨也。"
                },
                {
                  "id": "p0330-b7-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0330-bk16"
                },
                {
                  "id": "p0330-b7-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "介謂刖一足者。"
                },
                {
                  "id": "p0330-b7-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "史記·張耳𨻰餘",
