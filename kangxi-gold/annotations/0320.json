              ],
              "elements": [
                {
                  "id": "p0320-b0-e4",
                  "class": "small",
                  "text": "集韻且古作"
                }
              ]
            },
            {
              "id": "p0320-b0-l4",
              "ord": 4,
              "src": [
                48,
