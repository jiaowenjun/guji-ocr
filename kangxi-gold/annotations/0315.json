              "elements": [
                {
                  "id": "p0315-b4-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "公，因以命氏。 又"
                },
                {
                  "id": "p0315-b4-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "逸書諡法",
                  "ref": "p0315-bk9"
                },
                {
                  "id": "p0315-b4-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "述義不克曰丁。 又"
                },
                {
                  "id": "p0315-b4-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "廣韻",
                  "ref": "p0315-bk10"
                },
                {
                  "id": "p0315-b4-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "集韻",
