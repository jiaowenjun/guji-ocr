              ],
              "src": [
                193,
                198
              ]
            },
            {
              "kind": "text",
              "id": "p0315-b2-s6",
              "text": "蕨苞玉粉"
            }
          ]
        },
        {
          "id": "p0315-b3",
          "ord": 3,
          "src": [
            204,
            262
          ],
          "segments": [
            {
              "kind": "text",
              "id": "p0315-b3-s0",
              "text": "生香壟，菌蔟紅丁出靜槎。"
