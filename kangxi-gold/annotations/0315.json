          "segments": [
            {
              "kind": "text",
              "id": "p0315-b0-s0",
              "text": "二音古通。 又丁水。"
            },
            {
              "kind": "book",
              "id": "p0315-b0-s1",
              "parts": [
                {
                  "text": "水經注",
                  "band": "p0315-b0"
                }
              ],
              "src": [
                16,
                21
              ]
            },
            {
              "kind": "text",
              "id": "p0315-b0-s2",
              "text": "泗水又東南流，丁溪水注之。 又"
            },
            {
              "kind": "br"
            },
            {
              "kind": "book",
              "id": "p0315-b0-s3",
              "parts": [
                {
                  "text": "爾雅·釋魚",
                  "band": "p0315-b0"
                }
              ],
              "src": [
                37,
                44
              ]
            },
            {
              "kind": "text",
              "id": "p0315-b0-s4",
              "text": "魚枕謂之丁。"
            },
            {
              "kind": "book",
              "id": "p0315-b0-s5",
              "parts": [
                {
                  "text": "註",
                  "band": "p0315-b0"
                }
              ],
              "src": [
                50,
                53
              ]
            },
            {
              "kind": "text",
              "id": "p0315-b0-s6",
              "text": "枕在魚頭骨中，形似篆書丁字。 又"
            }
          ]
        },
        {
          "id": "p0315-b1",
          "ord": 1,
          "src": [
            71,
            135
          ],
          "segments": [
            {
              "kind": "text",
              "id": "p0315-b1-s0",
              "text": "丁子，科斗也。初生如丁有尾。"
            },
            {
              "kind": "book",
              "id": "p0315-b1-s1",
              "parts": [
                {
                  "text": "莊子·天下篇",
                  "band": "p0315-b1"
                }
              ],
              "src": [
                85,
                93
              ]
            },
            {
              "kind": "text",
              "id": "p0315-b1-s2",
              "text": "丁子有尾。 又肉丁，"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0315-b1-s3",
              "text": "瘡名。"
            },
            {
              "kind": "book",
              "id": "p0315-b1-s4",
              "parts": [
                {
                  "text": "物類相感賦",
                  "band": "p0315-b1"
                }
              ],
              "src": [
                107,
                114
              ]
            },
            {
              "kind": "text",
              "id": "p0315-b1-s5",
              "text": "身上生肉丁，芝蔴花擦之。 又烏丁，茶名。見"
            }
          ]
        },
        {
          "id": "p0315-b2",
          "ord": 2,
          "src": [
            137,
            202
          ],
          "segments": [
