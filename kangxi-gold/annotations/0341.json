              ],
              "elements": [
                {
                  "id": "p0341-b0-e0",
                  "class": "small",
                  "text": "練主用栗。又匰主。周禮·春官司巫，掌羣巫之政令，祭祀則供匰"
                }
              ]
            },
            {
              "id": "p0341-b0-l1",
              "ord": 1,
              "src": [
                38,
                75
              ],
              "elements": [
                {
                  "id": "p0341-b0-e1",
                  "class": "small",
                  "text": "主。註主神所依也。匰，盛主之器。 又禮·曲禮居不主奧。疏主，猶"
                }
              ]
            }
          ]
        },
        {
          "id": "p0341-b1",
          "ord": 1,
          "src": [
            77,
            145
          ],
          "lines": [
            {
              "id": "p0341-b1-l0",
              "ord": 0,
              "src": [
                77,
                110
              ],
              "elements": [
                {
                  "id": "p0341-b1-e0",
                  "class": "small",
                  "text": "坐也。 又晉語陽子剛而主能。註上也。 又姓。隋主胄，明主問"
                }
              ]
            },
            {
              "id": "p0341-b1-l1",
              "ord": 1,
              "src": [
                111,
                145
              ],
              "elements": [
                {
                  "id": "p0341-b1-e1",
                  "class": "small",
                  "text": "禮。又主父，複姓。 又正韻陟慮切。同注。荀子·宥坐篇主量必平"
                }
              ]
            }
          ]
        },
        {
          "id": "p0341-b2",
          "ord": 2,
          "src": [
            147,
            225
          ],
          "lines": [
            {
              "id": "p0341-b2-l0",
              "ord": 0,
              "src": [
                147,
                153
              ],
              "elements": [
                {
                  "id": "p0341-b2-e0",
                  "class": "small",
                  "text": "似法。註"
                }
              ]
            },
            {
              "id": "p0341-b2-l1",
              "ord": 1,
              "src": [
                154,
                159
              ],
              "elements": [
                {
                  "id": "p0341-b2-e1",
                  "class": "small",
                  "text": "主，同註。"
                }
              ]
            },
            {
              "id": "p0341-b2-l2",
              "ord": 2,
              "src": [
                160,
                162
              ],
              "elements": [
                {
                  "id": "p0341-b2-e2",
                  "class": "large",
                  "text": "丼"
                }
              ]
            },
            {
              "id": "p0341-b2-l3",
              "ord": 3,
              "src": [
                163,
                195
              ],
              "elements": [
                {
                  "id": "p0341-b2-e3",
                  "class": "small",
                  "text": "廣韻集韻韻會正韻𠀤同井。說文八家一井，象構"
                }
              ]
            },
            {
              "id": "p0341-b2-l4",
              "ord": 4,
              "src": [
                196,
                225
              ],
              "elements": [
                {
                  "id": "p0341-b2-e4",
                  "class": "small",
                  "text": "𩏑形，丶𦉥之象也。徐曰𩏑，井垣也。周禮謂之井樹。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0341-b3",
          "ord": 3,
          "src": [
            227,
            291
          ],
          "lines": [
            {
              "id": "p0341-b3-l0",
              "ord": 0,
              "src": [
                227,
                247
              ],
              "elements": [
                {
                  "id": "p0341-b3-e0",
                  "class": "small",
                  "text": "古者以瓶𦉥汲。本作丼，省作井。 又姓。"
                }
              ]
            },
            {
              "id": "p0341-b3-l1",
              "ord": 1,
              "src": [
                248,
                267
              ],
              "elements": [
                {
                  "id": "p0341-b3-e1",
                  "class": "small",
                  "text": " 又集韻都感切，音黕。投物井中聲。"
                }
              ]
            },
            {
              "id": "p0341-b3-l2",
              "ord": 2,
              "src": [
                268,
                275
              ],
              "elements": [
