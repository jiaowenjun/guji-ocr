                  "text": "增"
                },
                {
                  "id": "p0341-b3-e3",
                  "class": "large",
                  "text": "𠁿"
                }
              ]
            },
            {
              "id": "p0341-b3-l3",
              "ord": 3,
              "src": [
                276,
                283
              ],
              "elements": [
                {
                  "id": "p0341-b3-e4",
                  "class": "small",
                  "text": "玉篇古文丹"
                }
              ]
            },
