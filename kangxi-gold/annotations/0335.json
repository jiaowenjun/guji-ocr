              ],
              "elements": [
                {
                  "id": "p0335-b3-e0",
                  "class": "small",
                  "text": "秋懷詩聊用布親串。註言賦詩布與親狎之人也。 又正韻樞"
                }
              ]
            },
            {
              "id": "p0335-b3-l1",
              "ord": 1,
              "src": [
                242,
                274
              ],
              "elements": [
                {
                  "id": "p0335-b3-e1",
                  "class": "small",
                  "text": "絹切，音釧。物相連貫也。與穿讀去聲通。穿，亦作串。前漢·司馬遷"
                }
              ]
            }
          ]
        },
        {
          "id": "p0335-b4",
          "ord": 4,
          "src": [
            276,
            336
          ],
          "lines": [
            {
              "id": "p0335-b4-l0",
