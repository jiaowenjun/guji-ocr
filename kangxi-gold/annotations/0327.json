              ],
              "elements": [
                {
                  "id": "p0327-b4-e1",
                  "class": "small",
                  "text": "與拯通。揚雄·羽獵賦丞民於豐桑。"
                }
              ]
            },
            {
              "id": "p0327-b4-l2",
              "ord": 2,
