                148,
                183
              ],
              "elements": [
                {
                  "id": "p0327-b2-e0",
                  "class": "small",
                  "text": "萬機。註應劭曰：丞者，承也。相者，助也。 又前漢·淳于長傳扶丞"
                }
              ]
            },
            {
              "id": "p0327-b2-l1",
              "ord": 1,
              "src": [
                184,
                214
              ],
              "elements": [
                {
                  "id": "p0327-b2-e1",
                  "class": "small",
                  "text": "左右，甚有甥舅之恩。 又宋史·天文志紫微垣西蕃七星，第七"
                }
              ]
            }
          ]
        },
        {
          "id": "p0327-b3",
          "ord": 3,
          "src": [
            216,
            279
          ],
          "lines": [
            {
              "id": "p0327-b3-l0",
