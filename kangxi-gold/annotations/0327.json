                216,
                247
              ],
              "elements": [
                {
                  "id": "p0327-b3-e0",
                  "class": "small",
                  "text": "星爲上丞。東蕃八星，第八星爲少丞。 又與承通。史記·張湯傳"
                }
              ]
            },
            {
              "id": "p0327-b3-l1",
              "ord": 1,
              "src": [
                248,
                279
              ],
              "elements": [
                {
                  "id": "p0327-b3-e1",
                  "class": "small",
                  "text": "於是丞上指。今本或作承。 又廣韻常證切，承去聲。縣名。在沂"
                }
              ]
            }
          ]
        },
        {
          "id": "p0327-b4",
          "ord": 4,
          "src": [
            281,
            350
          ],
          "lines": [
