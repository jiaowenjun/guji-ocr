                  "ref": "p0312-bk4"
                },
                {
                  "id": "p0312-b3-e10",
                  "class": "small",
                  "sem": "gloss",
                  "text": "惟初大始，道立於一。造分天地，化成萬物。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0312-b4",
          "ord": 4,
          "src": [
