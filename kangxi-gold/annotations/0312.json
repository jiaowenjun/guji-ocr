              ],
              "elements": [
                {
                  "id": "p0312-b4-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "廣韻",
                  "ref": "p0312-bk5"
                },
                {
                  "id": "p0312-b4-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "數之始也，物之極也。"
                },
                {
                  "id": "p0312-b4-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "易·繫辭",
                  "ref": "p0312-bk6"
                },
                {
                  "id": "p0312-b4-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "天一地二。"
                },
                {
                  "id": "p0312-b4-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "老子·道德經",
                  "ref": "p0312-bk7"
                },
                {
                  "id": "p0312-b4-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "道生"
                }
              ]
            },
            {
              "id": "p0312-b4-l1",
              "ord": 1,
              "src": [
                129,
                166
              ],
              "elements": [
                {
                  "id": "p0312-b4-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "一，一生二。 又"
                },
                {
                  "id": "p0312-b4-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "廣韻",
                  "ref": "p0312-bk8"
                },
                {
                  "id": "p0312-b4-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "同也。"
                },
                {
                  "id": "p0312-b4-e9",
                  "class": "small",
                  "sem": "title",
                  "text": "禮·樂記",
                  "ref": "p0312-bk9"
                },
                {
                  "id": "p0312-b4-e10",
                  "class": "small",
                  "sem": "gloss",
                  "text": "禮樂𠛬政，其極一也。"
                },
                {
                  "id": "p0312-b4-e11",
                  "class": "small",
                  "sem": "title",
                  "text": "史記·儒",
                  "ref": "p0312-bk10"
                }
              ]
            }
          ]
        },
        {
          "id": "p0312-b5",
          "ord": 5,
          "src": [
            168,
            228
          ],
          "lines": [
            {
              "id": "p0312-b5-l0",
              "ord": 0,
              "src": [
                168,
                196
              ],
              "elements": [
                {
                  "id": "p0312-b5-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "林傳",
                  "ref": "p0312-bk10"
                },
                {
                  "id": "p0312-b5-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "韓生推詩之意，而爲內外傳數萬言，其語頗與齊魯閒殊，"
                }
              ]
            },
            {
              "id": "p0312-b5-l1",
              "ord": 1,
              "src": [
                197,
                228
              ],
              "elements": [
                {
                  "id": "p0312-b5-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "然其歸一也。 又少也。"
                },
                {
                  "id": "p0312-b5-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "顏延之·庭誥文",
                  "ref": "p0312-bk11"
                },
                {
                  "id": "p0312-b5-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "選書務一不尚煩密。"
                },
                {
                  "id": "p0312-b5-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "何",
                  "ref": "p0312-bk12"
                }
              ]
            }
          ]
        },
        {
          "id": "p0312-b6",
          "ord": 6,
          "src": [
            230,
            294
          ],
          "lines": [
            {
              "id": "p0312-b6-l0",
              "ord": 0,
              "src": [
                230,
                262
              ],
              "elements": [
                {
                  "id": "p0312-b6-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "承天·答顏永嘉書",
                  "ref": "p0312-bk12"
                },
                {
                  "id": "p0312-b6-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "竊願吾子舍兼而遵一也。 又"
                },
                {
                  "id": "p0312-b6-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "增韻",
                  "ref": "p0312-bk13"
                },
                {
                  "id": "p0312-b6-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "純也。"
                },
                {
                  "id": "p0312-b6-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "易·",
                  "ref": "p0312-bk14"
                }
              ]
            },
            {
              "id": "p0312-b6-l1",
              "ord": 1,
              "src": [
                263,
                294
              ],
              "elements": [
                {
                  "id": "p0312-b6-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "繫辭",
                  "ref": "p0312-bk14"
                },
                {
                  "id": "p0312-b6-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "天下之動貞夫一。"
                },
                {
                  "id": "p0312-b6-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "老子·道德經",
                  "ref": "p0312-bk15"
                },
                {
                  "id": "p0312-b6-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "天得一以淸，地得一以寧，"
                }
              ]
            }
          ]
        },
        {
          "id": "p0312-b7",
          "ord": 7,
          "src": [
            296,
            358
          ],
          "lines": [
            {
              "id": "p0312-b7-l0",
              "ord": 0,
              "src": [
                296,
                323
              ],
              "elements": [
                {
                  "id": "p0312-b7-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "神得一以靈，谷得一以盈，萬物得一以生，侯王得一以爲天下"
                }
              ]
            },
            {
              "id": "p0312-b7-l1",
              "ord": 1,
              "src": [
                324,
                358
              ],
              "elements": [
                {
                  "id": "p0312-b7-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "正。 又均也。"
                },
                {
                  "id": "p0312-b7-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "唐書·薛平傳",
                  "ref": "p0312-bk16"
                },
                {
                  "id": "p0312-b7-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "兵鎧完礪，徭賦均一。 又誠也。"
                },
                {
                  "id": "p0312-b7-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "中庸",
                  "ref": "p0312-bk17"
