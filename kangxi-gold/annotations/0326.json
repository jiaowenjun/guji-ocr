              "elements": [
                {
                  "id": "p0326-b2-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "之靈域兮，仍羽人之丹丘。惟民生之每每兮，佇盤桓以躊蹰。古"
                }
              ]
            },
            {
              "id": "p0326-b2-l1",
              "ord": 1,
              "src": [
                167,
                196
              ],
              "elements": [
                {
                  "id": "p0326-b2-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丘區聲通。"
                },
                {
                  "id": "p0326-b2-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "顏師古曰",
                  "ref": "p0326-bk4"
                },
                {
                  "id": "p0326-b2-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "古語丘區二字音不別，今讀則異。互見匚"
                }
              ]
            }
          ]
        },
