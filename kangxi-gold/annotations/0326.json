              "elements": [
                {
                  "id": "p0326-b1-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": " 又叶苦高切，音尻。"
                },
                {
                  "id": "p0326-b1-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "楚辭·九懷",
                  "ref": "p0326-bk2"
                },
                {
                  "id": "p0326-b1-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "玄鳥兮辭歸，飛翔兮靈丘。望谿"
                }
              ]
            },
            {
              "id": "p0326-b1-l1",
              "ord": 1,
              "src": [
                104,
                136
              ],
              "elements": [
                {
                  "id": "p0326-b1-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "兮蓊鬰，熊羆兮呴嘷。 又叶丘於切，音區。"
                },
                {
                  "id": "p0326-b1-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "𨻰琳·大荒賦",
                  "ref": "p0326-bk3"
                },
                {
                  "id": "p0326-b1-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "過不死"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b2",
          "ord": 2,
          "src": [
            138,
            196
