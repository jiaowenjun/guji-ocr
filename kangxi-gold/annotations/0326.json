          "lines": [
            {
              "id": "p0326-b0-l0",
              "ord": 0,
              "src": [
                6,
                37
              ],
              "elements": [
                {
                  "id": "p0326-b0-e0",
                  "class": "small",
                  "text": "子涉淇，至于頓丘。叶下媒期。小雅楊園之道，猗于畝丘。叶下詩"
                }
              ]
            },
            {
              "id": "p0326-b0-l1",
              "ord": 1,
              "src": [
                38,
                70
              ],
              "elements": [
                {
                  "id": "p0326-b0-e1",
                  "class": "small",
                  "text": "之。左傳·僖十五年史蘇占之曰：不利行師，敗於宗丘。叶上姬旗。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b1",
          "ord": 1,
          "src": [
            72,
            136
          ],
          "lines": [
            {
              "id": "p0326-b1-l0",
              "ord": 0,
              "src": [
                72,
                103
              ],
              "elements": [
                {
                  "id": "p0326-b1-e0",
                  "class": "small",
                  "text": " 又叶苦高切，音尻。楚辭·九懷玄鳥兮辭歸，飛翔兮靈丘。望谿"
                }
              ]
            },
            {
              "id": "p0326-b1-l1",
              "ord": 1,
              "src": [
                104,
                136
              ],
              "elements": [
                {
                  "id": "p0326-b1-e1",
                  "class": "small",
                  "text": "兮蓊鬰，熊羆兮呴嘷。 又叶丘於切，音區。𨻰琳·大荒賦過不死"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b2",
          "ord": 2,
          "src": [
            138,
            196
          ],
          "lines": [
            {
              "id": "p0326-b2-l0",
              "ord": 0,
              "src": [
                138,
                166
              ],
              "elements": [
                {
                  "id": "p0326-b2-e0",
                  "class": "small",
                  "text": "之靈域兮，仍羽人之丹丘。惟民生之每每兮，佇盤桓以躊蹰。古"
                }
              ]
            },
            {
              "id": "p0326-b2-l1",
              "ord": 1,
              "src": [
                167,
                196
              ],
              "elements": [
                {
                  "id": "p0326-b2-e1",
                  "class": "small",
                  "text": "丘區聲通。顏師古曰古語丘區二字音不別，今讀則異。互見匚"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b3",
          "ord": 3,
          "src": [
            198,
            265
          ],
          "lines": [
            {
              "id": "p0326-b3-l0",
              "ord": 0,
              "src": [
                198,
                208
              ],
              "elements": [
                {
                  "id": "p0326-b3-e0",
                  "class": "small",
                  "text": "部區字註。 集韻"
                }
              ]
            },
            {
              "id": "p0326-b3-l1",
              "ord": 1,
              "src": [
                209,
                218
              ],
              "elements": [
                {
                  "id": "p0326-b3-e1",
                  "class": "small",
                  "text": "本作丠，亦作𡊣。"
                }
              ]
            },
            {
              "id": "p0326-b3-l2",
              "ord": 2,
              "src": [
                219,
                237
              ],
              "elements": [
                {
                  "id": "p0326-b3-e2",
                  "class": "large",
                  "text": "㐀"
                },
                {
                  "id": "p0326-b3-e3",
                  "class": "small",
                  "text": ":正字通同丘。風俗通二人"
                }
              ]
            },
            {
              "id": "p0326-b3-l3",
              "ord": 3,
              "src": [
                238,
                251
              ],
              "elements": [
                {
                  "id": "p0326-b3-e4",
                  "class": "small",
                  "text": "立一上。一者，地也。象形。"
                }
              ]
            },
            {
              "id": "p0326-b3-l4",
              "ord": 4,
              "src": [
                252,
                260
              ],
              "elements": [
                {
                  "id": "p0326-b3-e5",
                  "class": "large",
                  "text": "丙"
                },
                {
                  "id": "p0326-b3-e6",
                  "class": "small",
                  "text": ":唐韻兵"
                }
              ]
            },
            {
              "id": "p0326-b3-l5",
              "ord": 5,
              "src": [
                261,
                265
              ],
              "elements": [
                {
                  "id": "p0326-b3-e7",
                  "class": "small",
                  "text": "永切集"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b4",
          "ord": 4,
          "src": [
            267,
            334
          ],
          "lines": [
            {
              "id": "p0326-b4-l0",
              "ord": 0,
              "src": [
                267,
                303
              ],
              "elements": [
                {
                  "id": "p0326-b4-e0",
                  "class": "small",
                  "text": "韻韻會正韻補永切，𠀤音炳。十幹名之一。爾雅·釋天太歲在丙"
                }
              ]
            },
            {
              "id": "p0326-b4-l1",
              "ord": 1,
              "src": [
                304,
                334
              ],
              "elements": [
                {
                  "id": "p0326-b4-e1",
                  "class": "small",
                  "text": "曰柔兆。月在丙曰修。說文南方之位也。南方屬火，而丙丁適當"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b5",
          "ord": 5,
          "src": [
            336,
            402
          ],
          "lines": [
            {
              "id": "p0326-b5-l0",
              "ord": 0,
              "src": [
                336,
                366
              ],
              "elements": [
                {
                  "id": "p0326-b5-e0",
                  "class": "small",
                  "text": "其處，故有文明之象。 又周髀算經上天名靑丙，下地曰靑戊。"
                }
              ]
            },
            {
              "id": "p0326-b5-l1",
              "ord": 1,
              "src": [
                367,
                402
              ],
              "elements": [
                {
                  "id": "p0326-b5-e1",
                  "class": "small",
                  "text": " 又張衡·東京賦大丙弭節，風后陪乗。註大丙，神名。 又集韻"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b6",
          "ord": 6,
          "src": [
            404,
            465
          ],
          "lines": [
            {
              "id": "p0326-b6-l0",
              "ord": 0,
              "src": [
                404,
                409
              ],
              "elements": [
                {
                  "id": "p0326-b6-e0",
                  "class": "small",
                  "text": "陂病切，音"
                }
              ]
            },
            {
              "id": "p0326-b6-l1",
              "ord": 1,
              "src": [
                410,
                415
              ],
              "elements": [
                {
                  "id": "p0326-b6-e1",
                  "class": "small",
                  "text": "柄。日名。"
                }
              ]
            },
            {
              "id": "p0326-b6-l2",
              "ord": 2,
              "src": [
                416,
                427
              ],
              "elements": [
                {
                  "id": "p0326-b6-e2",
                  "class": "large",
                  "text": "五"
                },
                {
                  "id": "p0326-b6-e3",
                  "class": "large",
                  "text": "㐁"
                },
                {
                  "id": "p0326-b6-e4",
                  "class": "small",
                  "text": "古文："
                },
                {
                  "id": "p0326-b6-e5",
                  "class": "large",
                  "text": "𠀬"
                }
              ]
            },
            {
              "id": "p0326-b6-l3",
              "ord": 3,
              "src": [
                428,
                445
              ],
              "elements": [
                {
                  "id": "p0326-b6-e6",
                  "class": "small",
                  "text": "集韻他點切，音忝。以舌鉤取也。"
                }
              ]
            },
            {
              "id": "p0326-b6-l4",
              "ord": 4,
              "src": [
                446,
                465
              ],
              "elements": [
                {
                  "id": "p0326-b6-e7",
                  "class": "small",
                  "text": "說文舌貌。从谷省，象形。精薀㐁"
                }
              ]
            }
          ]
        },
        {
          "id": "p0326-b7",
          "ord": 7,
          "src": [
            467,
            532
          ],
          "lines": [
            {
              "id": "p0326-b7-l0",
              "ord": 0,
              "src": [
                467,
                495
              ],
              "elements": [
                {
                  "id": "p0326-b7-e0",
                  "class": "small",
                  "text": "以舌在口外，露舌耑舐物。人有持短長術，以言鉤人者，孟子斥"
                }
              ]
            },
            {
              "id": "p0326-b7-l1",
              "ord": 1,
              "src": [
                496,
                532
              ],
              "elements": [
                {
                  "id": "p0326-b7-e1",
                  "class": "small",
                  "text": "爲穿窬。 又玉篇唐韻集韻𠀤他念切，添去聲。義同。〇按㐁字，"
                }
              ]
            }
          ]
        }
      ]
