          "segments": [
            {
              "kind": "text",
              "id": "p0325-b0-s0",
              "text": "曰丘。 又前高後下曰旄丘。"
            },
            {
              "kind": "book",
              "id": "p0325-b0-s1",
              "parts": [
                {
                  "text": "博雅",
                  "band": "p0325-b0"
