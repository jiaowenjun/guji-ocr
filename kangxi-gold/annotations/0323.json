  "pages": [
    {
      "id": "p0323",
      "no": 323,
      "src": [
        0,
        4
      ],
      "bands": [
        {
          "id": "p0323-b0",
          "ord": 0,
          "src": [
            6,
            71
          ],
          "lines": [
            {
              "id": "p0323-b0-l0",
              "ord": 0,
              "src": [
                6,
                37
              ],
              "elements": [
                {
                  "id": "p0323-b0-e0",
                  "class": "small",
                  "text": "且者，姑與物爲雷同，而志不在也。 又姓。宋且謹修，明且𥳑。俗"
                }
              ]
            },
            {
              "id": "p0323-b0-l1",
              "ord": 1,
              "src": [
                38,
                71
              ],
              "elements": [
                {
                  "id": "p0323-b0-e1",
                  "class": "small",
                  "text": "誤讀苴。 又通作俎。薦牲具。祭祀燕饗用之。 又集韻韻會正"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b1",
          "ord": 1,
          "src": [
            73,
            141
          ],
          "lines": [
            {
              "id": "p0323-b1-l0",
              "ord": 0,
              "src": [
                73,
                109
              ],
              "elements": [
                {
                  "id": "p0323-b1-e0",
                  "class": "small",
                  "text": "韻𡘋子余切，音疽。說文薦也。 又同趄。行不進也。易·夬卦其行"
                }
              ]
            },
            {
              "id": "p0323-b1-l1",
              "ord": 1,
              "src": [
                110,
                141
              ],
              "elements": [
                {
                  "id": "p0323-b1-e1",
                  "class": "small",
                  "text": "次且。別作趦趄。 又多貌。詩·大雅籩豆有且。 又蝍蛆亦曰卽"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b2",
          "ord": 2,
          "src": [
            143,
            211
          ],
          "lines": [
            {
              "id": "p0323-b2-l0",
              "ord": 0,
              "src": [
                143,
                176
              ],
              "elements": [
                {
                  "id": "p0323-b2-e0",
                  "class": "small",
                  "text": "且。史記·龜筴傳騰蛇之神，而殆於卽且。 又爾雅·釋天六月爲"
                }
              ]
            },
            {
              "id": "p0323-b2-l1",
              "ord": 1,
              "src": [
                177,
                211
              ],
              "elements": [
                {
                  "id": "p0323-b2-e1",
                  "class": "small",
                  "text": "且。郭註闕詁。或云：一作焦月。六月盛熱，故曰焦。 又巴且，見司"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b3",
          "ord": 3,
          "src": [
            213,
            281
          ],
          "lines": [
            {
              "id": "p0323-b3-l0",
              "ord": 0,
              "src": [
                213,
                248
              ],
              "elements": [
                {
                  "id": "p0323-b3-e0",
                  "class": "small",
                  "text": "馬相如賦。史記作猼且，卽巴焦。 又語餘聲。詩·鄭風士曰旣且。"
                }
              ]
            },
            {
              "id": "p0323-b3-l1",
              "ord": 1,
              "src": [
                249,
                281
              ],
              "elements": [
                {
                  "id": "p0323-b3-e1",
                  "class": "small",
                  "text": "朱傳音疽。語辭，與乃見狂且，其樂只且，匪我思且，椒聊且，曰父"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b4",
          "ord": 4,
          "src": [
            283,
            354
          ],
          "lines": [
            {
              "id": "p0323-b4-l0",
              "ord": 0,
              "src": [
                283,
                318
              ],
              "elements": [
                {
                  "id": "p0323-b4-e0",
                  "class": "small",
                  "text": "母且，諸且字皆語餘聲。 又集韻韻會正韻𠀤叢租切。與徂同，"
                }
              ]
            },
            {
              "id": "p0323-b4-l1",
              "ord": 1,
              "src": [
                319,
                354
              ],
              "elements": [
                {
                  "id": "p0323-b4-e1",
                  "class": "small",
                  "text": "往也。 又韻會七序切，徐去聲。恭敬貌。詩·周頌有萋有且。 正"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b5",
          "ord": 5,
          "src": [
            356,
            415
          ],
          "lines": [
            {
              "id": "p0323-b5-l0",
              "ord": 0,
              "src": [
                356,
                387
              ],
              "elements": [
                {
                  "id": "p0323-b5-e0",
                  "class": "small",
                  "text": "字通說文且从几，足有二橫。一，地也。象藉於地形。音阻。阻詛諧"
                }
              ]
            },
            {
              "id": "p0323-b5-l1",
              "ord": 1,
              "src": [
                388,
                415
              ],
              "elements": [
                {
                  "id": "p0323-b5-e1",
                  "class": "small",
                  "text": "且爲聲，餘義皆假借。孫愐譌用子余切。韻會馬韻且引說文義"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b6",
          "ord": 6,
          "src": [
            417,
            477
          ],
          "lines": [
            {
              "id": "p0323-b6-l0",
              "ord": 0,
              "src": [
                417,
                442
              ],
              "elements": [
                {
                  "id": "p0323-b6-e0",
                  "class": "small",
                  "text": "同俎，譌轉魚韻，爲孫切所蔽，音同疽，音義相矛盾。又"
                }
              ]
            },
            {
              "id": "p0323-b6-l1",
              "ord": 1,
              "src": [
                443,
                466
              ],
              "elements": [
                {
                  "id": "p0323-b6-e1",
                  "class": "small",
                  "text": "俎本作且，且字借義旣廣，故別加半肉作俎以別之。"
                }
              ]
            },
            {
              "id": "p0323-b6-l2",
              "ord": 2,
              "src": [
                467,
                474
              ],
              "elements": [
                {
                  "id": "p0323-b6-e2",
                  "class": "large",
                  "text": "丕"
                },
                {
                  "id": "p0323-b6-e3",
                  "class": "small",
                  "text": ":廣韻"
                }
              ]
            },
            {
              "id": "p0323-b6-l3",
              "ord": 3,
              "src": [
                475,
                477
              ],
              "elements": [
                {
                  "id": "p0323-b6-e4",
                  "class": "small",
                  "text": "敷悲"
                }
              ]
            }
          ]
        },
        {
          "id": "p0323-b7",
          "ord": 7,
          "src": [
            479,
            549
          ],
          "lines": [
            {
              "id": "p0323-b7-l0",
              "ord": 0,
              "src": [
                479,
                516
              ],
              "elements": [
                {
                  "id": "p0323-b7-e0",
                  "class": "small",
                  "text": "切集韻韻會攀悲切正韻鋪悲切，𡘋音胚。大也。書·大禹謨嘉乃"
                }
              ]
            },
            {
              "id": "p0323-b7-l1",
              "ord": 1,
              "src": [
                517,
                549
              ],
              "elements": [
                {
                  "id": "p0323-b7-e1",
                  "class": "small",
                  "text": "丕績。 又奉也。前漢·郊祀志丕天之大律。註奉天之大法也。"
                }
              ]
            }
          ]
        }
      ]
    }
