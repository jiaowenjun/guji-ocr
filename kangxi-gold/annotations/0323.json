                  "class": "small",
                  "sem": "title",
                  "text": "韻會",
                  "ref": "p0323-bk21"
                },
                {
                  "id": "p0323-b7-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "攀悲切"
                },
                {
                  "id": "p0323-b7-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "正韻",
                  "ref": "p0323-bk22"
                },
                {
                  "id": "p0323-b7-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "鋪悲切，𡘋音胚。大也。"
                },
                {
                  "id": "p0323-b7-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "書·大禹謨",
                  "ref": "p0323-bk23"
                },
                {
                  "id": "p0323-b7-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "嘉乃"
                }
              ]
            },
            {
              "id": "p0323-b7-l1",
              "ord": 1,
              "src": [
                517,
                549
              ],
              "elements": [
                {
                  "id": "p0323-b7-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丕績。 又奉也。"
                },
                {
                  "id": "p0323-b7-e9",
                  "class": "small",
                  "sem": "title",
                  "text": "前漢·郊祀志",
                  "ref": "p0323-bk24"
                },
                {
                  "id": "p0323-b7-e10",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丕天之大律。"
                },
                {
                  "id": "p0323-b7-e11",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0323-bk25"
                },
                {
                  "id": "p0323-b7-e12",
                  "class": "small",
                  "sem": "gloss",
                  "text": "奉天之大法也。"
                }
              ]
            }
          ]
        }
