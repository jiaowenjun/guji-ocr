                  "band": "p0323-b1"
                }
              ],
              "src": [
                69,
                75
              ]
            },
            {
              "kind": "text",
              "id": "p0323-b1-s1",
              "text": "𡘋子余切，音疽。"
            },
            {
              "kind": "book",
              "id": "p0323-b1-s2",
              "parts": [
                {
                  "text": "說文",
                  "band": "p0323-b1"
                }
              ],
              "src": [
                84,
                88
              ]
            },
            {
              "kind": "text",
              "id": "p0323-b1-s3",
              "text": "薦也。 又同趄。行不進也。"
            },
            {
              "kind": "book",
              "id": "p0323-b1-s4",
              "parts": [
                {
                  "text": "易·夬卦",
                  "band": "p0323-b1"
                }
              ],
              "src": [
                101,
                107
              ]
            },
            {
              "kind": "text",
              "id": "p0323-b1-s5",
              "text": "其行"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0323-b1-s6",
              "text": "次且。別作趦趄。 又多貌。"
            },
            {
              "kind": "book",
              "id": "p0323-b1-s7",
              "parts": [
                {
                  "text": "詩·大雅",
                  "band": "p0323-b1"
                }
              ],
              "src": [
                123,
                129
              ]
            },
            {
              "kind": "text",
              "id": "p0323-b1-s8",
              "text": "籩豆有且。 又蝍蛆亦曰卽"
            }
          ]
        },
        {
          "id": "p0323-b2",
          "ord": 2,
          "src": [
            143,
            211
          ],
          "segments": [
            {
              "kind": "text",
              "id": "p0323-b2-s0",
