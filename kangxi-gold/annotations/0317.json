                109
              ],
              "elements": [
                {
                  "id": "p0317-b1-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "食之客，則布席，席閒函丈。"
                },
                {
                  "id": "p0317-b1-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0317-bk5"
                },
                {
                  "id": "p0317-b1-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "函，容也。 又長老之稱。"
                },
                {
                  "id": "p0317-b1-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "易·師卦",
                  "ref": "p0317-bk6"
                },
                {
                  "id": "p0317-b1-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "師"
                }
              ]
            },
            {
              "id": "p0317-b1-l1",
              "ord": 1,
              "src": [
                110,
                139
              ],
              "elements": [
                {
                  "id": "p0317-b1-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "貞丈人吉。又朋友尊稱。"
                },
                {
                  "id": "p0317-b1-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "長編",
                  "ref": "p0317-bk7"
                },
                {
                  "id": "p0317-b1-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "富鄭公稱范文正公曰范十二丈。"
                }
              ]
            }
          ]
        },
        {
