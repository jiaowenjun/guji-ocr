                {
                  "id": "p0317-b2-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "方丈渾連水。 又"
                },
                {
                  "id": "p0317-b2-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "杜甫詩",
                  "ref": "p0317-bk9"
                },
