                  "id": "p0317-b0-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "傳·昭三十二年",
                  "ref": "p0317-bk4"
                },
                {
                  "id": "p0317-b0-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "以令役於諸侯，屬役賦丈。"
                },
                {
                  "id": "p0317-b0-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "疏",
                  "ref": "p0317-bk0"
                },
                {
                  "id": "p0317-b0-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "屬聚下役，課賦尺"
                }
              ]
            },
            {
              "id": "p0317-b0-l1",
              "ord": 1,
              "src": [
                38,
                72
              ],
              "elements": [
                {
                  "id": "p0317-b0-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丈。又"
                },
                {
                  "id": "p0317-b0-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "哀元年",
                  "ref": "p0317-bk1"
                },
                {
                  "id": "p0317-b0-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "廣丈高倍。"
                },
                {
                  "id": "p0317-b0-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0317-bk2"
                },
                {
                  "id": "p0317-b0-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "壘厚一丈高二万。又"
                },
                {
                  "id": "p0317-b0-e9",
                  "class": "small",
                  "sem": "title",
                  "text": "禮·曲禮",
                  "ref": "p0317-bk3"
                },
                {
                  "id": "p0317-b0-e10",
                  "class": "small",
                  "sem": "gloss",
                  "text": "若非飮"
                }
              ]
            }
          ]
        },
        {
          "id": "p0317-b1",
          "ord": 1,
          "src": [
            74,
            139
          ],
          "lines": [
            {
              "id": "p0317-b1-l0",
