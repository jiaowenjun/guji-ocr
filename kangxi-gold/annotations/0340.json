              "elements": [
                {
                  "id": "p0340-b3-e4",
                  "class": "small",
                  "text": "董仲舒·賢良策行高而恩厚，知明而意美。愛民而"
                }
              ]
            }
          ]
        },
        {
          "id": "p0340-b4",
          "ord": 4,
          "src": [
