              "elements": [
                {
                  "id": "p0319-b2-e10",
                  "class": "small",
                  "sem": "gloss",
                  "text": "下之下，對上之稱。"
                },
                {
                  "id": "p0319-b2-e11",
                  "class": "small",
                  "sem": "title",
                  "text": "易·乾·文言",
