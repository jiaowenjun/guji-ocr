                  "text": "說文",
                  "ref": "p0319-bk0"
                },
                {
                  "id": "p0319-b0-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "上，高也。指事。時掌切。○按字有動靜音，諸韻皆以"
                }
              ]
            },
            {
              "id": "p0319-b0-l1",
              "ord": 1,
              "src": [
                39,
                70
              ],
              "elements": [
                {
                  "id": "p0319-b0-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "上聲，是掌切，爲升上之上，屬動，去聲，時亮切，爲本在物上之上，"
                }
              ]
            }
          ]
        },
        {
          "id": "p0319-b1",
          "ord": 1,
          "src": [
            72,
            125
          ],
          "lines": [
            {
              "id": "p0319-b1-l0",
              "ord": 0,
              "src": [
                72,
                97
              ],
              "elements": [
                {
                  "id": "p0319-b1-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "屬靜。今詳說文上聲上字，高也，是指物而言，則本在物"
                }
              ]
            },
            {
              "id": "p0319-b1-l1",
              "ord": 1,
              "src": [
                98,
                121
              ],
              "elements": [
                {
                  "id": "p0319-b1-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "上之上亦作上聲矣。依諸韻分動靜音爲是。後倣此。"
                }
              ]
            },
            {
              "id": "p0319-b1-l2",
              "ord": 2,
              "src": [
                122,
                125
              ],
              "elements": [
                {
                  "id": "p0319-b1-e2",
                  "class": "large",
                  "sem": "head",
                  "text": "下"
                },
                {
                  "id": "p0319-b1-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "古"
                }
              ]
            }
          ]
        },
        {
