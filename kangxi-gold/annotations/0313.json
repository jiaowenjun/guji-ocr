                164
              ],
              "elements": [
                {
                  "id": "p0313-b2-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "在紫微宮門外。太一星，在天一南半度。 又太一，山名，卽終南"
                }
              ]
            },
            {
              "id": "p0313-b2-l1",
              "ord": 1,
              "src": [
                165,
                199
              ],
              "elements": [
                {
                  "id": "p0313-b2-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "山。一名太乙。 又三一。"
                },
                {
                  "id": "p0313-b2-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "前漢·郊祀志",
                  "ref": "p0313-bk5"
                },
                {
                  "id": "p0313-b2-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "以太牢祀三一。"
                },
                {
                  "id": "p0313-b2-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0313-bk6"
                },
