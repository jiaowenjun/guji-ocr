                },
                {
                  "id": "p0313-b3-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "尺一選舉。"
                },
                {
                  "id": "p0313-b3-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0313-bk8"
                },
                {
                  "id": "p0313-b3-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "版長尺一，以寫詔書。 又百一，詩篇名，魏應璩"
                }
              ]
            }
          ]
        },
        {
