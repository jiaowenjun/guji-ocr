              "elements": [
                {
                  "id": "p0313-b3-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "一，泰一。泰一者，天地未分元氣也。 又尺一，詔版也。"
                },
                {
                  "id": "p0313-b3-e1",
                  "class": "small",
