              "src": [
                33,
                37
              ]
            },
            {
              "kind": "text",
              "id": "p0324-b0-s2",
              "text": "作"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0324-b0-s3",
              "text": "伾。"
            },
            {
              "kind": "book",
              "id": "p0324-b0-s4",
              "parts": [
                {
                  "text": "國語",
