              ],
              "src": [
                41,
                45
              ]
            },
            {
              "kind": "text",
              "id": "p0324-b0-s5",
              "text": "作丕。 又元也。"
            },
            {
              "kind": "book",
              "id": "p0324-b0-s6",
              "parts": [
                {
                  "text": "書·金縢",
