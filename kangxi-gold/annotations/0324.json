                },
                {
                  "id": "p0324-b3-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "始制切，𠀤音勢。代也。"
                },
                {
                  "id": "p0324-b3-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "詩·大雅",
                  "ref": "p0324-bk9"
                },
                {
                  "id": "p0324-b3-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "本支百世。又"
                },
                {
                  "id": "p0324-b3-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "論",
                  "ref": "p0324-bk10"
                }
              ]
            },
            {
              "id": "p0324-b3-l1",
              "ord": 1,
              "src": [
                232,
                265
              ],
              "elements": [
                {
                  "id": "p0324-b3-e8",
                  "class": "small",
                  "sem": "title",
                  "text": "語",
                  "ref": "p0324-bk10"
                },
                {
                  "id": "p0324-b3-e9",
                  "class": "small",
                  "sem": "gloss",
                  "text": "必世而後仁。"
                },
                {
                  "id": "p0324-b3-e10",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0324-bk11"
                },
                {
                  "id": "p0324-b3-e11",
                  "class": "small",
                  "sem": "gloss",
                  "text": "三十年爲一世。"
                },
                {
                  "id": "p0324-b3-e12",
                  "class": "small",
                  "sem": "title",
                  "text": "左傳·宣三年",
                  "ref": "p0324-bk12"
                },
                {
                  "id": "p0324-b3-e13",
                  "class": "small",
                  "sem": "gloss",
                  "text": "王孫滿曰：卜世"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b4",
          "ord": 4,
          "src": [
