              "elements": [
                {
                  "id": "p0324-b5-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "又與生同。"
                },
                {
                  "id": "p0324-b5-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "列子·天瑞篇",
                  "ref": "p0324-bk16"
                },
                {
                  "id": "p0324-b5-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "亦如人自世之老，皮膚爪髮，隨世隨落。"
                }
              ]
            },
            {
              "id": "p0324-b5-l1",
              "ord": 1,
              "src": [
