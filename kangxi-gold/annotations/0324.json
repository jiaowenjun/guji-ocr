      ],
      "bands": [
        {
          "id": "p0324-b0",
          "ord": 0,
          "src": [
            6,
            74
          ],
          "lines": [
            {
              "id": "p0324-b0-l0",
              "ord": 0,
              "src": [
                6,
                38
              ],
              "elements": [
                {
                  "id": "p0324-b0-e0",
                  "class": "small",
                  "text": "又姓。春秋晉大夫丕鄭。亦作㔻。 又同岯。山名。大邳山。史記作"
                }
              ]
            },
            {
              "id": "p0324-b0-l1",
              "ord": 1,
              "src": [
                39,
                74
              ],
              "elements": [
                {
                  "id": "p0324-b0-e1",
                  "class": "small",
                  "text": "伾。國語作丕。 又元也。書·金縢是有丕子之責于天。史記以丕"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b1",
          "ord": 1,
          "src": [
            76,
            136
          ],
          "lines": [
            {
              "id": "p0324-b1-l0",
              "ord": 0,
              "src": [
                76,
                106
              ],
              "elements": [
                {
                  "id": "p0324-b1-e0",
                  "class": "small",
                  "text": "爲負。索隱引鄭氏曰：丕讀作負。○按廣韻玉篇諸書音切，倶本"
                }
              ]
            },
            {
              "id": "p0324-b1-l1",
              "ord": 1,
              "src": [
                107,
                136
              ],
              "elements": [
                {
                  "id": "p0324-b1-e1",
                  "class": "small",
                  "text": "音和，惟重脣輕脣之音，多用交互。後學不考，遂成譌舛，如丕用"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b2",
          "ord": 2,
          "src": [
            138,
            190
          ],
          "lines": [
            {
              "id": "p0324-b2-l0",
              "ord": 0,
              "src": [
                138,
                156
              ],
              "elements": [
                {
                  "id": "p0324-b2-e0",
                  "class": "small",
                  "text": "敷悲切之類。是以敷母輕脣之音，切滂母"
                }
              ]
            },
            {
              "id": "p0324-b2-l1",
              "ord": 1,
              "src": [
                157,
                174
              ],
              "elements": [
                {
                  "id": "p0324-b2-e1",
                  "class": "small",
                  "text": "重脣之字。宜從集韻諸書攀悲切爲是。"
                }
              ]
            },
            {
              "id": "p0324-b2-l2",
              "ord": 2,
              "src": [
                175,
                182
              ],
              "elements": [
                {
                  "id": "p0324-b2-e2",
                  "class": "large",
                  "text": "世"
                },
                {
                  "id": "p0324-b2-e3",
                  "class": "small",
                  "text": "古文："
                },
                {
                  "id": "p0324-b2-e4",
                  "class": "large",
                  "text": "卋"
                }
              ]
            },
            {
              "id": "p0324-b2-l3",
              "ord": 3,
              "src": [
                183,
                187
              ],
              "elements": [
                {
                  "id": "p0324-b2-e5",
                  "class": "small",
                  "text": "廣韻"
                }
              ]
            },
            {
              "id": "p0324-b2-l4",
              "ord": 4,
              "src": [
                188,
                190
              ],
              "elements": [
                {
                  "id": "p0324-b2-e6",
                  "class": "small",
                  "text": "舒制"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b3",
          "ord": 3,
          "src": [
            192,
            265
          ],
          "lines": [
            {
              "id": "p0324-b3-l0",
              "ord": 0,
              "src": [
                192,
                231
              ],
              "elements": [
                {
                  "id": "p0324-b3-e0",
                  "class": "small",
                  "text": "切集韻韻會正韻始制切，𠀤音勢。代也。詩·大雅本支百世。又論"
                }
              ]
            },
            {
              "id": "p0324-b3-l1",
              "ord": 1,
              "src": [
                232,
                265
              ],
              "elements": [
                {
                  "id": "p0324-b3-e1",
                  "class": "small",
                  "text": "語必世而後仁。註三十年爲一世。左傳·宣三年王孫滿曰：卜世"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b4",
          "ord": 4,
          "src": [
            267,
            329
          ],
          "lines": [
            {
              "id": "p0324-b4-l0",
              "ord": 0,
              "src": [
                267,
                299
              ],
              "elements": [
                {
                  "id": "p0324-b4-e0",
                  "class": "small",
                  "text": "三十，卜年七百，天所命也。 又維摩經大千世界。註世謂同居"
                }
              ]
            },
            {
              "id": "p0324-b4-l1",
              "ord": 1,
              "src": [
                300,
                329
              ],
              "elements": [
                {
                  "id": "p0324-b4-e1",
                  "class": "small",
                  "text": "天地之閒，界謂各有彼此之別。 又姓。風俗通秦大夫世鈞。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b5",
          "ord": 5,
          "src": [
            331,
            398
          ],
          "lines": [
            {
              "id": "p0324-b5-l0",
              "ord": 0,
              "src": [
                331,
                362
              ],
              "elements": [
                {
                  "id": "p0324-b5-e0",
                  "class": "small",
                  "text": "又與生同。列子·天瑞篇亦如人自世之老，皮膚爪髮，隨世隨落。"
                }
              ]
            },
            {
              "id": "p0324-b5-l1",
              "ord": 1,
              "src": [
                363,
                398
              ],
              "elements": [
                {
                  "id": "p0324-b5-e1",
                  "class": "small",
                  "text": "註世與生同。 又韻補叶私列切，音薛。詩·大雅殷鑒不遠，在夏"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b6",
          "ord": 6,
          "src": [
            400,
            466
          ],
          "lines": [
            {
              "id": "p0324-b6-l0",
              "ord": 0,
              "src": [
                400,
                425
              ],
              "elements": [
                {
                  "id": "p0324-b6-e0",
                  "class": "small",
                  "text": "后之世。叶上撥。撥音撇。晉書·樂志匡時拯俗，休"
                }
              ]
            },
            {
              "id": "p0324-b6-l1",
              "ord": 1,
              "src": [
                426,
                450
              ],
              "elements": [
                {
                  "id": "p0324-b6-e1",
                  "class": "small",
                  "text": "功蓋世。宇宙旣康，九有有截。 集韻書作𠀍。"
                }
              ]
            },
            {
              "id": "p0324-b6-l2",
              "ord": 2,
              "src": [
                451,
                454
              ],
              "elements": [
                {
                  "id": "p0324-b6-e2",
                  "class": "large",
                  "text": "𠀍"
                }
              ]
            },
            {
              "id": "p0324-b6-l3",
              "ord": 3,
              "src": [
                455,
                459
              ],
              "elements": [
                {
                  "id": "p0324-b6-e3",
                  "class": "small",
                  "text": "集韻"
                }
              ]
            },
            {
              "id": "p0324-b6-l4",
              "ord": 4,
              "src": [
                460,
                463
              ],
              "elements": [
                {
                  "id": "p0324-b6-e4",
                  "class": "small",
                  "text": "同上。"
                }
              ]
            },
            {
              "id": "p0324-b6-l5",
              "ord": 5,
              "src": [
                464,
                466
              ],
              "elements": [
                {
                  "id": "p0324-b6-e5",
                  "class": "large",
                  "text": "丘"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b7",
          "ord": 7,
          "src": [
            468,
            533
          ],
          "lines": [
            {
              "id": "p0324-b7-l0",
              "ord": 0,
              "src": [
                468,
                473
              ],
              "elements": [
                {
                  "id": "p0324-b7-e0",
                  "class": "small",
                  "text": "古文："
                },
                {
                  "id": "p0324-b7-e1",
                  "class": "large",
                  "text": "㘳"
                }
              ]
            },
            {
              "id": "p0324-b7-l1",
              "ord": 1,
              "src": [
                474,
                505
              ],
              "elements": [
                {
                  "id": "p0324-b7-e2",
                  "class": "small",
                  "text": "廣韻去鳩切集韻韻會祛尤切正韻驅尤切，𠀤音蚯。"
                }
              ]
            },
            {
              "id": "p0324-b7-l2",
              "ord": 2,
              "src": [
                506,
                533
              ],
              "elements": [
                {
                  "id": "p0324-b7-e3",
                  "class": "small",
                  "text": "阜也，高也。四方高，中央下曰丘。爾雅·釋丘非人爲之"
                }
              ]
            }
          ]
        }
      ]
    }
