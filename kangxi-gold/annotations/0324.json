            },
            {
              "id": "p0324-b0-l1",
              "ord": 1,
              "src": [
                39,
                74
              ],
              "elements": [
                {
                  "id": "p0324-b0-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "伾。"
                },
                {
                  "id": "p0324-b0-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "國語",
                  "ref": "p0324-bk1"
                },
                {
                  "id": "p0324-b0-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "作丕。 又元也。"
                },
                {
                  "id": "p0324-b0-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "書·金縢",
                  "ref": "p0324-bk2"
                },
                {
                  "id": "p0324-b0-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "是有丕子之責于天。"
                },
                {
                  "id": "p0324-b0-e8",
                  "class": "small",
                  "sem": "title",
                  "text": "史記",
                  "ref": "p0324-bk3"
                },
                {
                  "id": "p0324-b0-e9",
                  "class": "small",
                  "sem": "gloss",
                  "text": "以丕"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b1",
          "ord": 1,
          "src": [
            76,
            136
          ],
          "lines": [
            {
              "id": "p0324-b1-l0",
              "ord": 0,
              "src": [
                76,
                106
              ],
              "elements": [
                {
                  "id": "p0324-b1-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "爲負。"
                },
                {
                  "id": "p0324-b1-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "索隱",
                  "ref": "p0324-bk4"
                },
                {
                  "id": "p0324-b1-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "引鄭氏曰：丕讀作負。○按廣韻玉篇諸書音切，倶本"
                }
              ]
            },
            {
              "id": "p0324-b1-l1",
              "ord": 1,
              "src": [
                107,
                136
              ],
              "elements": [
                {
                  "id": "p0324-b1-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "音和，惟重脣輕脣之音，多用交互。後學不考，遂成譌舛，如丕用"
                }
              ]
            }
          ]
        },
        {
          "id": "p0324-b2",
          "ord": 2,
          "src": [
            138,
            190
          ],
          "lines": [
            {
              "id": "p0324-b2-l0",
              "ord": 0,
              "src": [
                138,
                156
              ],
              "elements": [
                {
                  "id": "p0324-b2-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "敷悲切之類。是以敷母輕脣之音，切滂母"
                }
              ]
            },
            {
              "id": "p0324-b2-l1",
              "ord": 1,
              "src": [
                157,
                174
              ],
              "elements": [
                {
                  "id": "p0324-b2-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "重脣之字。宜從集韻諸書攀悲切爲是。"
                }
              ]
            },
            {
              "id": "p0324-b2-l2",
              "ord": 2,
              "src": [
                175,
                182
              ],
              "elements": [
                {
                  "id": "p0324-b2-e2",
                  "class": "large",
                  "sem": "head",
                  "text": "世"
                },
                {
                  "id": "p0324-b2-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "古文："
                },
                {
                  "id": "p0324-b2-e4",
                  "class": "large",
                  "sem": "head",
                  "text": "卋"
                }
              ]
            },
