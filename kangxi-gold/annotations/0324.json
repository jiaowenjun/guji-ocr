              "src": [
                53,
                59
              ]
            },
            {
              "kind": "text",
              "id": "p0324-b0-s7",
              "text": "是有丕子之責于天。"
            },
            {
              "kind": "book",
              "id": "p0324-b0-s8",
              "parts": [
                {
                  "text": "史記",
                  "band": "p0324-b0"
