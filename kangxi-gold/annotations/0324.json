                },
                {
                  "id": "p0324-b5-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "世與生同。 又"
                },
                {
                  "id": "p0324-b5-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "韻補",
                  "ref": "p0324-bk18"
                },
                {
                  "id": "p0324-b5-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "叶私列切，音薛。"
                },
                {
                  "id": "p0324-b5-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "詩·大雅",
                  "ref": "p0324-bk19"
                },
                {
                  "id": "p0324-b5-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "殷鑒不遠，在夏"
                }
              ]
            }
