              "src": [
                217,
                223
              ]
            },
            {
              "kind": "text",
              "id": "p0324-b3-s6",
              "text": "本支百世。又"
            },
            {
              "kind": "book",
              "id": "p0324-b3-s7",
              "parts": [
                {
                  "text": "論\n語",
                  "band": "p0324-b3"
