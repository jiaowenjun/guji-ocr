              "src": [
                71,
                101
              ],
              "elements": [
                {
                  "id": "p0321-b1-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "彩翠如芙蓉。蓋因華跗而比擬之。胡傳讀不如卜，非。又"
                },
                {
                  "id": "p0321-b1-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "古詩·日",
                  "ref": "p0321-bk2"
                }
              ]
            },
            {
              "id": "p0321-b1-l1",
              "ord": 1,
              "src": [
                102,
                130
              ],
              "elements": [
                {
                  "id": "p0321-b1-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "出東南隅行",
                  "ref": "p0321-bk2"
                },
                {
                  "id": "p0321-b1-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "使君謝羅敷，還可共載不。羅敷前致辭，使君亦何"
                }
              ]
            }
          ]
        },
        {
          "id": "p0321-b2",
          "ord": 2,
          "src": [
            132,
            191
          ],
          "lines": [
            {
              "id": "p0321-b2-l0",
              "ord": 0,
              "src": [
                132,
                161
              ],
              "elements": [
                {
                  "id": "p0321-b2-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "愚。使君自有婦，羅敷自有夫。〇按愚當讀若吾，疑模切，與敷不"
                }
              ]
            },
            {
              "id": "p0321-b2-l1",
              "ord": 1,
              "src": [
                162,
                191
              ],
              "elements": [
                {
                  "id": "p0321-b2-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "夫叶。敷不夫本同模韻，正字通不改音符，叶夫愚，非是。 又與"
                }
              ]
            }
          ]
        },
        {
          "id": "p0321-b3",
          "ord": 3,
          "src": [
            193,
            259
          ],
          "lines": [
            {
              "id": "p0321-b3-l0",
              "ord": 0,
              "src": [
                193,
                227
              ],
              "elements": [
                {
                  "id": "p0321-b3-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丕同。"
                },
                {
                  "id": "p0321-b3-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "書·大誥",
                  "ref": "p0321-bk3"
                },
                {
                  "id": "p0321-b3-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "爾丕克遠省。馬融作不。"
                },
                {
                  "id": "p0321-b3-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "秦·詛楚文",
                  "ref": "p0321-bk4"
                },
                {
                  "id": "p0321-b3-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "不顯大神巫咸。"
                }
              ]
            },
            {
              "id": "p0321-b3-l1",
              "ord": 1,
              "src": [
                228,
                259
              ],
              "elements": [
                {
                  "id": "p0321-b3-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "秦·和鐘銘",
                  "ref": "p0321-bk5"
                },
                {
                  "id": "p0321-b3-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "不顯皇祖。𠀤與詩周頌不顯不承同。不顯不承，猶書"
                }
              ]
            }
          ]
        },
        {
          "id": "p0321-b4",
          "ord": 4,
          "src": [
            261,
            325
