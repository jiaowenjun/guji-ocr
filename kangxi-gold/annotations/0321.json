            },
            {
              "id": "p0321-b4-l1",
              "ord": 1,
              "src": [
                295,
                325
              ],
              "elements": [
                {
                  "id": "p0321-b4-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "知，而致有理者與。君子所敬，而小人所不者與。"
                },
                {
                  "id": "p0321-b4-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0321-bk8"
                },
                {
                  "id": "p0321-b4-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "謂小人所鄙"
