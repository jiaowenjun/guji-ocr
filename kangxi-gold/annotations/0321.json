                294
              ],
              "elements": [
                {
                  "id": "p0321-b4-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "云丕顯丕承也。 又"
                },
                {
                  "id": "p0321-b4-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "韻補",
                  "ref": "p0321-bk6"
                },
                {
                  "id": "p0321-b4-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "叶補美切，音彼。"
                },
                {
                  "id": "p0321-b4-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "荀子·賦論篇",
                  "ref": "p0321-bk7"
                },
                {
                  "id": "p0321-b4-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "𥳑然易"
