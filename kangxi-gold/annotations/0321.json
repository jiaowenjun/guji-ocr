              "src": [
                387,
                391
              ],
              "elements": [
                {
                  "id": "p0321-b6-e0",
                  "class": "small",
                  "text": "平，其義"
                }
              ]
            },
            {
              "id": "p0321-b6-l1",
              "ord": 1,
              "src": [
                392,
                396
              ],
              "elements": [
                {
                  "id": "p0321-b6-e1",
                  "class": "small",
                  "text": "則一也。"
                }
              ]
            },
            {
              "id": "p0321-b6-l2",
              "ord": 2,
              "src": [
                397,
                426
              ],
              "elements": [
                {
                  "id": "p0321-b6-e2",
                  "class": "large",
                  "text": "与"
                },
                {
                  "id": "p0321-b6-e3",
                  "class": "small",
                  "text": ":廣韻集韻正韻𠀤同與。說文賜予也。一"
                }
              ]
            },
            {
              "id": "p0321-b6-l3",
              "ord": 3,
              "src": [
                427,
                445
              ],
              "elements": [
                {
                  "id": "p0321-b6-e4",
                  "class": "small",
                  "text": "勺爲与。六書正譌寡則均，故从一勺"
                }
              ]
            },
            {
              "id": "p0321-b6-l4",
              "ord": 4,
              "src": [
