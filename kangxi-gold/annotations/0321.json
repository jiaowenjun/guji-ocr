              ],
              "elements": [
                {
                  "id": "p0321-b0-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "齊記",
                  "ref": "p0321-bk1"
                },
                {
                  "id": "p0321-b0-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "引摯虞畿服經，不，與詩鄂不之不同。李白詩：兹山何峻秀，"
                }
              ]
            }
          ]
        },
        {
          "id": "p0321-b1",
          "ord": 1,
          "src": [
            71,
