              "elements": [
                {
                  "id": "p0321-b7-e0",
                  "class": "small",
                  "text": "韻會彌殄切正韻美辨切，𡘋音眄。說文不見也。徐曰左右壅蔽"
                }
              ]
            },
            {
              "id": "p0321-b7-l1",
              "ord": 1,
              "src": [
