                  "id": "p0314-b7-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "此。俗作叮嚀。 又丁寧，鉦也。"
                },
                {
                  "id": "p0314-b7-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "左傳·宣四年",
                  "ref": "p0314-bk20"
                },
                {
                  "id": "p0314-b7-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "楚伯棼射王，汰輈及"
                }
              ]
            },
