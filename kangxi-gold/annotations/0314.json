              "elements": [
                {
                  "id": "p0314-b6-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "鬻於市。 又零丁，或作伶仃，失志貌。"
                },
                {
                  "id": "p0314-b6-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "晉書·李密傳",
                  "ref": "p0314-bk18"
                },
                {
                  "id": "p0314-b6-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "零丁孤苦，至"
                }
              ]
            },
            {
              "id": "p0314-b6-l1",
              "ord": 1,
              "src": [
                436,
                466
              ],
              "elements": [
                {
                  "id": "p0314-b6-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "於成立。 又彼此相屬曰丁寧。"
                },
                {
                  "id": "p0314-b6-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "後漢·郞覬傳",
                  "ref": "p0314-bk19"
                },
                {
                  "id": "p0314-b6-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丁寧再三，留神於"
                }
              ]
            }
          ]
        },
