              ],
              "elements": [
                {
                  "id": "p0314-b5-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "忽傳",
                  "ref": "p0314-bk16"
                },
                {
                  "id": "p0314-b5-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "畬丁溪子。"
                },
                {
                  "id": "p0314-b5-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "橘錄",
                  "ref": "p0314-bk17"
                },
                {
                  "id": "p0314-b5-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "金橘高不及尺許，結實繁多。園丁種之，以"
                }
              ]
            }
          ]
        },
        {
          "id": "p0314-b6",
          "ord": 6,
          "src": [
