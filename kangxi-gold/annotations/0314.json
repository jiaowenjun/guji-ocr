          "segments": [
            {
              "kind": "text",
              "id": "p0314-b0-s0",
              "text": "物必以金木爲丁附著之，因聲借爲丙丁字。"
            },
            {
              "kind": "book",
              "id": "p0314-b0-s1",
              "parts": [
                {
                  "text": "爾雅·釋天",
                  "band": "p0314-b0"
                }
              ],
              "src": [
                25,
                32
              ]
            },
            {
              "kind": "text",
              "id": "p0314-b0-s2",
              "text": "太歲在"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0314-b0-s3",
              "text": "丁曰彊圉，月在丁曰圉。"
            },
            {
              "kind": "book",
              "id": "p0314-b0-s4",
              "parts": [
                {
                  "text": "禮·月令",
                  "band": "p0314-b0"
