                  "id": "p0314-b4-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "子·養生主",
                  "ref": "p0314-bk10"
                },
                {
                  "id": "p0314-b4-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "庖丁解牛。"
                },
                {
                  "id": "p0314-b4-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "杜甫詩",
                  "ref": "p0314-bk11"
                },
                {
                  "id": "p0314-b4-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "畦丁負籠至。"
                },
                {
                  "id": "p0314-b4-e4",
                  "class": "small",
                  "sem": "title",
                  "text": "宋史·高宗紀",
                  "ref": "p0314-bk12"
                },
                {
                  "id": "p0314-b4-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "團敎峒"
                }
              ]
            },
            {
              "id": "p0314-b4-l1",
              "ord": 1,
              "src": [
                304,
                336
              ],
              "elements": [
                {
                  "id": "p0314-b4-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "丁槍杖手。"
                },
                {
                  "id": "p0314-b4-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "又",
                  "ref": "p0314-bk13"
                },
                {
                  "id": "p0314-b4-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "罷廉州貢珠，縱蛋丁自便。"
                },
                {
                  "id": "p0314-b4-e9",
                  "class": "small",
                  "sem": "title",
                  "text": "何異傳",
                  "ref": "p0314-bk14"
                },
                {
                  "id": "p0314-b4-e10",
                  "class": "small",
                  "sem": "gloss",
                  "text": "募山丁，捕首亂"
                }
              ]
            }
          ]
        },
        {
          "id": "p0314-b5",
          "ord": 5,
          "src": [
            338,
