              ],
              "src": [
                47,
                53
              ]
            },
            {
              "kind": "text",
              "id": "p0314-b0-s5",
              "text": "仲春之月上丁，命樂正習舞釋"
            }
          ]
        },
        {
          "id": "p0314-b1",
          "ord": 1,
          "src": [
            68,
            132
          ],
          "segments": [
            {
              "kind": "text",
              "id": "p0314-b1-s0",
              "text": "菜。又"
