              ],
              "elements": [
                {
                  "id": "p0314-b5-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "者。"
                },
                {
                  "id": "p0314-b5-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "唐璘傳",
                  "ref": "p0314-bk15"
                },
                {
                  "id": "p0314-b5-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "團結漁業茶鹽舟夫蘆丁，悉備燎舟之具。"
                },
                {
                  "id": "p0314-b5-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "元史·博爾",
                  "ref": "p0314-bk16"
                }
              ]
            },
            {
              "id": "p0314-b5-l1",
              "ord": 1,
              "src": [
