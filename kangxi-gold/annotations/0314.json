              "id": "p0314-b7-l1",
              "ord": 1,
              "src": [
                501,
                530
              ],
              "elements": [
                {
                  "id": "p0314-b7-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "鼔跗，著於丁寧。 又丁東，聲也。凡玉珮鐵馬聲皆曰丁當。當東"
                }
              ]
            }
          ]
