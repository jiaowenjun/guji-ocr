              "src": [
                145,
                150
              ]
            },
            {
              "kind": "text",
              "id": "p0314-b2-s2",
              "text": "論功超五丁。 又六丁，神名。"
            },
            {
              "kind": "book",
              "id": "p0314-b2-s3",
              "parts": [
                {
                  "text": "道\n書",
