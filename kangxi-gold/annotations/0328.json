              "elements": [
                {
                  "id": "p0328-b0-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "爲秋門，萬物已入，一，閉門象也。"
                },
                {
                  "id": "p0328-b0-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "六書正譌",
                  "ref": "p0328-bk0"
                },
                {
                  "id": "p0328-b0-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "後人以此字類丣，故"
                }
              ]
            }
          ]
        },
