                106
              ],
              "elements": [
                {
                  "id": "p0316-b1-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "韻",
                  "ref": "p0316-bk4"
                },
                {
                  "id": "p0316-b1-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "戚悉切，𡘋音桼。少陽數也。"
                },
                {
                  "id": "p0316-b1-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "說文",
                  "ref": "p0316-bk5"
                },
                {
                  "id": "p0316-b1-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "陽之正也，从一，微隂从中衺"
                }
              ]
            },
            {
              "id": "p0316-b1-l1",
              "ord": 1,
              "src": [
                107,
                143
              ],
              "elements": [
                {
                  "id": "p0316-b1-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "出也。"
                },
                {
                  "id": "p0316-b1-e5",
                  "class": "small",
                  "sem": "title",
                  "text": "書·舜典",
                  "ref": "p0316-bk6"
                },
                {
                  "id": "p0316-b1-e6",
                  "class": "small",
                  "sem": "gloss",
                  "text": "在璿璣玉衡，以齊七政。"
                },
                {
                  "id": "p0316-b1-e7",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0316-bk7"
                },
                {
                  "id": "p0316-b1-e8",
                  "class": "small",
                  "sem": "gloss",
                  "text": "七政，日月五星也。"
                },
                {
                  "id": "p0316-b1-e9",
                  "class": "small",
                  "sem": "title",
                  "text": "詩·唐",
                  "ref": "p0316-bk8"
                }
              ]
            }
          ]
        },
        {
          "id": "p0316-b2",
          "ord": 2,
          "src": [
            145,
            206
          ],
          "lines": [
            {
              "id": "p0316-b2-l0",
