              ],
              "src": [
                282,
                287
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b4-s2",
              "text": "殷七七，名文祥。"
            },
            {
              "kind": "book",
              "id": "p0316-b4-s3",
              "parts": [
                {
                  "text": "蘇軾詩",
                  "band": "p0316-b4"
                }
              ],
              "src": [
                295,
                300
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b4-s4",
              "text": "安得"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0316-b4-s5",
              "text": "道人殷七七，不論時節遣花開。 "
            },
            {
              "kind": "book",
              "id": "p0316-b4-s6",
              "parts": [
                {
                  "text": "正字通",
                  "band": "p0316-b4"
                }
              ],
              "src": [
                318,
                323
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b4-s7",
              "text": "或通作㭍桼漆。"
            },
            {
              "kind": "mark",
              "id": "p0316-b4-s8",
              "text": "增",
              "style": "circled"
