          "segments": [
            {
              "kind": "text",
              "id": "p0316-b0-s0",
              "text": "氣舒也。丂之轉注。"
            },
            {
              "kind": "book",
              "id": "p0316-b0-s1",
              "parts": [
                {
                  "text": "精蘊",
                  "band": "p0316-b0"
                }
              ],
              "src": [
                15,
                19
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b0-s2",
              "text": "氣出而易也。反丂見"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0316-b0-s3",
              "text": "意。重之爲大笑聲，借譴怒聲，皆動於聲氣也。"
            },
            {
              "kind": "br"
            },
            {
              "kind": "head",
