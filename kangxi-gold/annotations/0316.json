              "id": "p0316-b3-l0",
              "ord": 0,
              "src": [
                208,
                237
              ],
              "elements": [
                {
                  "id": "p0316-b3-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "毅七激，崔駰七依，曹植七啓，張協七命，繼之凡十餘家。 又三"
                }
              ]
            },
            {
              "id": "p0316-b3-l1",
              "ord": 1,
              "src": [
                238,
                270
              ],
              "elements": [
                {
                  "id": "p0316-b3-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "七，藥名。"
                },
                {
                  "id": "p0316-b3-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "本草綱目",
                  "ref": "p0316-bk10"
                },
                {
                  "id": "p0316-b3-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "言葉左三右四，故名。一說本名山桼。 又姓。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0316-b4",
          "ord": 4,
          "src": [
            272,
            333
          ],
          "lines": [
