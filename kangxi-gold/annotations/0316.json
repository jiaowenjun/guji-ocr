                302
              ],
              "elements": [
                {
                  "id": "p0316-b4-e0",
                  "class": "small",
                  "sem": "gloss",
                  "text": "明七希賢。 又人名。"
                },
                {
                  "id": "p0316-b4-e1",
                  "class": "small",
                  "sem": "title",
                  "text": "續仙傳",
                  "ref": "p0316-bk11"
                },
                {
                  "id": "p0316-b4-e2",
                  "class": "small",
                  "sem": "gloss",
                  "text": "殷七七，名文祥。"
                },
                {
                  "id": "p0316-b4-e3",
                  "class": "small",
                  "sem": "title",
                  "text": "蘇軾詩",
                  "ref": "p0316-bk12"
                },
                {
                  "id": "p0316-b4-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "安得"
                }
              ]
            },
            {
              "id": "p0316-b4-l1",
              "ord": 1,
              "src": [
                303,
                333
              ],
              "elements": [
                {
                  "id": "p0316-b4-e5",
                  "class": "small",
                  "sem": "gloss",
                  "text": "道人殷七七，不論時節遣花開。 "
                },
                {
                  "id": "p0316-b4-e6",
                  "class": "small",
                  "sem": "title",
                  "text": "正字通",
                  "ref": "p0316-bk13"
                },
                {
                  "id": "p0316-b4-e7",
                  "class": "small",
                  "sem": "gloss",
                  "text": "或通作㭍桼漆。"
