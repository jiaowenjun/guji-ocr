                175
              ],
              "elements": [
                {
                  "id": "p0316-b2-e0",
                  "class": "small",
                  "sem": "title",
                  "text": "風",
                  "ref": "p0316-bk8"
                },
                {
                  "id": "p0316-b2-e1",
                  "class": "small",
                  "sem": "gloss",
                  "text": "豈曰無衣七兮。"
                },
                {
                  "id": "p0316-b2-e2",
                  "class": "small",
                  "sem": "title",
                  "text": "註",
                  "ref": "p0316-bk9"
                },
                {
                  "id": "p0316-b2-e3",
                  "class": "small",
                  "sem": "gloss",
                  "text": "侯伯七命，車服皆以七爲節。 又詞家以"
                }
              ]
            },
            {
              "id": "p0316-b2-l1",
              "ord": 1,
              "src": [
                176,
                206
              ],
              "elements": [
                {
                  "id": "p0316-b2-e4",
                  "class": "small",
                  "sem": "gloss",
                  "text": "七名篇，雖八首，問對凡七。七者，問對之別名，始枚乗七發，後傅"
                }
              ]
            }
          ]
        },
        {
          "id": "p0316-b3",
          "ord": 3,
          "src": [
            208,
            270
          ],
          "lines": [
