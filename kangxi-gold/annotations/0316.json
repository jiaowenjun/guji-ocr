              "src": [
                69,
                75
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b1-s1",
              "text": "戚悉切，𡘋音桼。少陽數也。"
            },
            {
              "kind": "book",
              "id": "p0316-b1-s2",
              "parts": [
                {
                  "text": "說文",
                  "band": "p0316-b1"
                }
              ],
              "src": [
                89,
                93
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b1-s3",
              "text": "陽之正也，从一，微隂从中衺"
            },
            {
              "kind": "br"
            },
            {
              "kind": "text",
              "id": "p0316-b1-s4",
              "text": "出也。"
            },
            {
              "kind": "book",
              "id": "p0316-b1-s5",
              "parts": [
                {
                  "text": "書·舜典",
                  "band": "p0316-b1"
                }
              ],
              "src": [
                110,
                116
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b1-s6",
              "text": "在璿璣玉衡，以齊七政。"
            },
            {
              "kind": "book",
              "id": "p0316-b1-s7",
              "parts": [
                {
                  "text": "註",
                  "band": "p0316-b1"
                }
              ],
              "src": [
                127,
                130
              ]
            },
            {
              "kind": "text",
              "id": "p0316-b1-s8",
              "text": "七政，日月五星也。"
            },
            {
              "kind": "book",
              "id": "p0316-b1-s9",
              "parts": [
                {
                  "text": "詩·唐",
                  "band": "p0316-b1"
