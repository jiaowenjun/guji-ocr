              ],
              "elements": [
                {
                  "id": "p0334-b8-e0",
                  "class": "large",
                  "text": "丱"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b9",
          "ord": 9,
          "src": [
            1400,
            1568
          ],
          "lines": [
            {
              "id": "p0334-b9-l0",
              "ord": 0,
              "src": [
                1400,
                1428
              ],
              "elements": [
                {
                  "id": "p0334-b9-e0",
                  "class": "small",
                  "text": "廣韻集韻韻會正韻𠀤古患切，音慣。同卝。"
                }
              ]
            },
            {
              "id": "p0334-b9-l1",
              "ord": 1,
              "src": [
                1429,
                1440
              ],
              "elements": [
                {
                  "id": "p0334-b9-e1",
                  "class": "small",
                  "text": "詩·齊風總角丱兮。"
                }
              ]
            },
            {
              "id": "p0334-b9-l2",
              "ord": 2,
              "src": [
                1441,
                1459
              ],
              "elements": [
                {
                  "id": "p0334-b9-e2",
                  "class": "small",
                  "text": "毛傳總角，聚兩髦也。丱，幼穉也。"
                }
              ]
            },
            {
              "id": "p0334-b9-l3",
              "ord": 3,
              "src": [
                1460,
                1568
              ],
              "elements": [
                {
                  "id": "p0334-b9-e3",
                  "class": "small",
                  "text": "朱傳丱，兩角貌。 又廣韻呼䁝切韻會合猛切正韻胡猛切。𠀤同礦。互詳蔔部卝字，石部礦字註。◎按《正韻》上聲梗韻，礦，亦作卝。去聲諫韻，卝，亦作丱。《字彙》丱爲總角之丱，卝爲銅錫礦之卝。丱卝分而爲二，非。"
                }
              ]
            }
          ]
        }
      ]
    }
