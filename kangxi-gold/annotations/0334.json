  "pages": [
    {
      "id": "p0334",
      "no": 334,
      "src": [
        0,
        4
      ],
      "bands": [
        {
          "id": "p0334-b0",
          "ord": 0,
          "src": [
            6,
            64
          ],
          "lines": [
            {
              "id": "p0334-b0-l0",
              "ord": 0,
              "src": [
                6,
                35
              ],
              "elements": [
                {
                  "id": "p0334-b0-e0",
                  "class": "small",
                  "text": "達問以曹事，曰中聖人。時謂酒淸爲聖人，濁者爲賢人。蘇軾詩："
                }
              ]
            },
            {
              "id": "p0334-b0-l1",
              "ord": 1,
              "src": [
                36,
                64
              ],
              "elements": [
                {
                  "id": "p0334-b0-e1",
                  "class": "small",
                  "text": "公特未知其趣耳，臣今時復一中之。則中酒之中，亦可讀平聲。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b1",
          "ord": 1,
          "src": [
            66,
            129
          ],
          "lines": [
            {
              "id": "p0334-b1-l0",
              "ord": 0,
              "src": [
                66,
                91
              ],
              "elements": [
                {
                  "id": "p0334-b1-e0",
                  "class": "small",
                  "text": "《通鑑》：周宣王成中與之名，註：當也。杜詩：今朝漢"
                }
              ]
            },
            {
              "id": "p0334-b1-l1",
              "ord": 1,
              "src": [
                92,
                112
              ],
              "elements": [
                {
                  "id": "p0334-b1-e1",
                  "class": "small",
                  "text": "社稷，新數中與年。則中與之中亦可讀去聲。"
                }
              ]
            },
            {
              "id": "p0334-b1-l2",
              "ord": 2,
              "src": [
                113,
                115
              ],
              "elements": [
                {
                  "id": "p0334-b1-e2",
                  "class": "large",
                  "text": "丮"
                }
              ]
            },
            {
              "id": "p0334-b1-l3",
              "ord": 3,
              "src": [
                116,
                122
              ],
              "elements": [
                {
                  "id": "p0334-b1-e3",
                  "class": "small",
                  "text": "唐韻几劇"
                }
              ]
            },
            {
              "id": "p0334-b1-l4",
              "ord": 4,
              "src": [
                123,
                129
              ],
              "elements": [
                {
                  "id": "p0334-b1-e4",
                  "class": "small",
                  "text": "切集韻訖"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b2",
          "ord": 2,
          "src": [
            131,
            204
          ],
          "lines": [
            {
              "id": "p0334-b2-l0",
              "ord": 0,
              "src": [
                131,
                166
              ],
              "elements": [
                {
                  "id": "p0334-b2-e0",
                  "class": "small",
                  "text": "逆切，𠀤音戟。說文丮，持也，象手有所丮據也。讀若戟。元包經丮"
                }
              ]
            },
            {
              "id": "p0334-b2-l1",
              "ord": 1,
              "src": [
                167,
                204
              ],
              "elements": [
                {
                  "id": "p0334-b2-e1",
                  "class": "small",
                  "text": "之摭。傳手之掇也。〇按《說文》《玉篇》丮𡙕音義小別。𡙕，捕罪人也。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b3",
          "ord": 3,
          "src": [
            206,
            271
          ],
          "lines": [
            {
              "id": "p0334-b3-l0",
              "ord": 0,
              "src": [
                206,
                211
              ],
              "elements": [
                {
                  "id": "p0334-b3-e0",
                  "class": "small",
                  "text": "从丮从㚔。"
                }
              ]
            },
            {
              "id": "p0334-b3-l1",
              "ord": 1,
              "src": [
                212,
                216
              ],
              "elements": [
                {
                  "id": "p0334-b3-e1",
                  "class": "small",
                  "text": "之入切。"
                }
              ]
            },
            {
              "id": "p0334-b3-l2",
              "ord": 2,
              "src": [
                217,
                219
              ],
              "elements": [
                {
                  "id": "p0334-b3-e2",
                  "class": "large",
                  "text": "丯"
                }
              ]
            },
            {
              "id": "p0334-b3-l3",
              "ord": 3,
              "src": [
                220,
                248
              ],
              "elements": [
                {
                  "id": "p0334-b3-e3",
                  "class": "small",
                  "text": "廣韻古拜切集韻居拜切，𠀤音介。說文艸蔡也。"
                }
              ]
            },
            {
              "id": "p0334-b3-l4",
              "ord": 4,
              "src": [
                249,
                271
              ],
              "elements": [
                {
                  "id": "p0334-b3-e4",
                  "class": "small",
                  "text": "象艸生散亂。凡丯之屬皆从丯。〇按《說文》丯與"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b4",
          "ord": 4,
          "src": [
            273,
            334
          ],
          "lines": [
            {
              "id": "p0334-b4-l0",
              "ord": 0,
              "src": [
                273,
                293
              ],
              "elements": [
                {
                  "id": "p0334-b4-e0",
                  "class": "small",
                  "text": "夆別。夆，相遮要害也，讀若害。《字彙》誤"
                }
              ]
            },
            {
              "id": "p0334-b4-l1",
              "ord": 1,
              "src": [
                294,
                312
              ],
              "elements": [
                {
                  "id": "p0334-b4-e1",
                  "class": "small",
                  "text": "以丯爲夆，移《說文》夆訓入丯註，非。"
                }
              ]
            },
            {
              "id": "p0334-b4-l2",
              "ord": 2,
              "src": [
                313,
                320
              ],
              "elements": [
                {
                  "id": "p0334-b4-e2",
                  "class": "large",
                  "text": "丰"
                },
                {
                  "id": "p0334-b4-e3",
                  "class": "small",
                  "text": "古文"
                },
                {
                  "id": "p0334-b4-e4",
                  "class": "large",
                  "text": "𫵮"
                }
              ]
            },
            {
              "id": "p0334-b4-l3",
              "ord": 3,
              "src": [
                321,
                327
              ],
              "elements": [
                {
                  "id": "p0334-b4-e5",
                  "class": "small",
                  "text": "集韻符風"
                }
              ]
            },
            {
              "id": "p0334-b4-l4",
              "ord": 4,
              "src": [
                328,
                334
              ],
              "elements": [
                {
                  "id": "p0334-b4-e6",
                  "class": "small",
                  "text": "切，音馮。丰"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b5",
          "ord": 5,
          "src": [
            336,
            402
          ],
          "lines": [
            {
              "id": "p0334-b5-l0",
              "ord": 0,
              "src": [
                336,
                370
              ],
              "elements": [
                {
                  "id": "p0334-b5-e0",
                  "class": "small",
                  "text": "茸，草盛貌。說文从生，上下達也。徐曰艸之生，上盛者，其下必深"
                }
              ]
            },
            {
              "id": "p0334-b5-l1",
              "ord": 1,
              "src": [
                371,
                402
              ],
              "elements": [
                {
                  "id": "p0334-b5-e1",
                  "class": "small",
                  "text": "根也。毛氏曰：凡邦夆峰豐等字从此。 又容色美好貌。詩·鄭風"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b6",
          "ord": 6,
          "src": [
            404,
            475
          ],
          "lines": [
            {
              "id": "p0334-b6-l0",
              "ord": 0,
              "src": [
                404,
                416
              ],
              "elements": [
                {
                  "id": "p0334-b6-e0",
                  "class": "small",
                  "text": "子之丰兮。 六書正譌"
                }
              ]
            },
            {
              "id": "p0334-b6-l1",
              "ord": 1,
              "src": [
                417,
                429
              ],
              "elements": [
                {
                  "id": "p0334-b6-e1",
                  "class": "small",
                  "text": "俗作丰，上畫从丿者，非。"
                }
              ]
            },
            {
              "id": "p0334-b6-l2",
              "ord": 2,
              "src": [
                430,
                436
              ],
              "elements": [
                {
                  "id": "p0334-b6-e2",
                  "class": "large",
                  "text": "四"
                },
                {
                  "id": "p0334-b6-e3",
                  "class": "large",
                  "text": "丱"
                }
              ]
            },
            {
              "id": "p0334-b6-l3",
              "ord": 3,
              "src": [
                437,
                457
              ],
              "elements": [
                {
                  "id": "p0334-b6-e4",
                  "class": "small",
                  "text": "廣韻集韻韻會正韻𠀤古患"
                }
              ]
            },
            {
              "id": "p0334-b6-l4",
              "ord": 4,
              "src": [
                458,
                475
              ],
              "elements": [
                {
                  "id": "p0334-b6-e5",
                  "class": "small",
                  "text": "切，音慣。同卝。詩·齊風總角丱"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b7",
          "ord": 7,
          "src": [
            477,
            547
          ],
          "lines": [
            {
              "id": "p0334-b7-l0",
              "ord": 0,
              "src": [
                477,
                514
              ],
              "elements": [
                {
                  "id": "p0334-b7-e0",
                  "class": "small",
                  "text": "兮。毛傳總角，聚兩髦也。丱，幼穉也。朱傳丱，兩角貌。 又廣韻呼"
                }
              ]
            },
            {
              "id": "p0334-b7-l1",
              "ord": 1,
              "src": [
                515,
                547
              ],
              "elements": [
                {
                  "id": "p0334-b7-e1",
                  "class": "small",
                  "text": "䁝切韻會合猛切正韻胡猛切。𠀤同礦。互詳蔔部卝字，石部礦"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
