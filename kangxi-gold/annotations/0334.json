  "pages": [
    {
      "id": "p0334",
      "no": 334,
      "src": [
        0,
        4
      ],
      "bands": [
        {
          "id": "p0334-b0",
          "ord": 0,
          "src": [
            6,
            64
          ],
          "lines": [
            {
              "id": "p0334-b0-l0",
              "ord": 0,
              "src": [
                6,
                35
              ],
              "elements": [
                {
                  "id": "p0334-b0-e0",
                  "class": "small",
                  "text": "達問以曹事，曰中聖人。時謂酒淸爲聖人，濁者爲賢人。蘇軾詩："
                }
              ]
            },
            {
              "id": "p0334-b0-l1",
              "ord": 1,
              "src": [
                36,
                64
              ],
              "elements": [
                {
                  "id": "p0334-b0-e1",
                  "class": "small",
                  "text": "公特未知其趣耳，臣今時復一中之。則中酒之中，亦可讀平聲。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b1",
          "ord": 1,
          "src": [
            66,
            127
          ],
          "lines": [
            {
              "id": "p0334-b1-l0",
              "ord": 0,
              "src": [
                66,
                91
              ],
              "elements": [
                {
                  "id": "p0334-b1-e0",
                  "class": "small",
                  "text": "《通鑑》：周宣王成中與之名，註：當也。杜詩：今朝漢"
                }
              ]
            },
            {
              "id": "p0334-b1-l1",
              "ord": 1,
              "src": [
                92,
                120
              ],
              "elements": [
                {
                  "id": "p0334-b1-e1",
                  "class": "small",
                  "text": "社稷，新數中與年。則中與之中亦可讀去聲。"
                },
                {
                  "id": "p0334-b1-e2",
                  "class": "large",
                  "text": "丮"
                },
                {
                  "id": "p0334-b1-e3",
                  "class": "small",
                  "text": "唐韻几劇"
                }
              ]
            },
            {
              "id": "p0334-b1-l2",
              "ord": 2,
              "src": [
                121,
                127
              ],
              "elements": [
                {
                  "id": "p0334-b1-e4",
                  "class": "small",
                  "text": "切集韻訖"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b2",
          "ord": 2,
          "src": [
            129,
            202
          ],
          "lines": [
            {
              "id": "p0334-b2-l0",
              "ord": 0,
              "src": [
                129,
                164
              ],
              "elements": [
                {
                  "id": "p0334-b2-e0",
                  "class": "small",
                  "text": "逆切，𠀤音戟。說文丮，持也，象手有所丮據也。讀若戟。元包經丮"
                }
              ]
            },
            {
              "id": "p0334-b2-l1",
              "ord": 1,
              "src": [
                165,
                202
              ],
              "elements": [
                {
                  "id": "p0334-b2-e1",
                  "class": "small",
                  "text": "之摭。傳手之掇也。◎按《說文》《玉篇》丮𡙕音義小別。𡙕，捕罪人也。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b3",
          "ord": 3,
          "src": [
            204,
            268
          ],
          "lines": [
            {
              "id": "p0334-b3-l0",
              "ord": 0,
              "src": [
                204,
                209
              ],
              "elements": [
                {
                  "id": "p0334-b3-e0",
                  "class": "small",
                  "text": "从丮从㚔。"
                }
              ]
            },
            {
              "id": "p0334-b3-l1",
              "ord": 1,
              "src": [
                210,
                244
              ],
              "elements": [
                {
                  "id": "p0334-b3-e1",
                  "class": "small",
                  "text": "之入切。"
                },
                {
                  "id": "p0334-b3-e2",
                  "class": "large",
                  "text": "丯"
                },
                {
                  "id": "p0334-b3-e3",
                  "class": "small",
                  "text": "廣韻古拜切集韻居拜切，𠀤音介。說文艸蔡也。"
                }
              ]
            },
            {
              "id": "p0334-b3-l2",
              "ord": 2,
              "src": [
                245,
                268
              ],
              "elements": [
                {
                  "id": "p0334-b3-e4",
                  "class": "small",
                  "text": "象艸生散亂。凡丯之屬皆从丯。◎按《說文》丯與夆"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b4",
          "ord": 4,
          "src": [
            270,
            307
          ],
          "lines": [
            {
              "id": "p0334-b4-l0",
              "ord": 0,
              "src": [
                270,
                307
              ],
              "elements": [
                {
                  "id": "p0334-b4-e0",
                  "class": "small",
                  "text": "別。夆，相遮要害也，讀若害。《字彙》誤以丯爲夆，移《說文》夆訓入丯註，非。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b5",
          "ord": 5,
          "src": [
            309,
            311
          ],
          "lines": [
            {
              "id": "p0334-b5-l0",
              "ord": 0,
              "src": [
                309,
                311
              ],
              "elements": [
                {
                  "id": "p0334-b5-e0",
                  "class": "large",
                  "text": "丰"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b6",
          "ord": 6,
          "src": [
            313,
            1351
          ],
          "lines": [
            {
              "id": "p0334-b6-l0",
              "ord": 0,
              "src": [
                313,
                331
              ],
              "elements": [
                {
                  "id": "p0334-b6-e0",
                  "class": "small",
                  "text": "集韻符風切，音馮。丰茸，草盛貌。"
                }
              ]
            },
            {
              "id": "p0334-b6-l1",
              "ord": 1,
              "src": [
                332,
                344
              ],
              "elements": [
                {
                  "id": "p0334-b6-e1",
                  "class": "small",
                  "text": "說文从生，上下達也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l2",
              "ord": 2,
              "src": [
                345,
                386
              ],
              "elements": [
                {
                  "id": "p0334-b6-e2",
                  "class": "small",
                  "text": "徐曰艸之生，上盛者，其下必深根也。毛氏曰：凡邦夆峰豐等字从此。 又容色美好貌。"
                }
              ]
            },
            {
              "id": "p0334-b6-l3",
              "ord": 3,
              "src": [
                387,
                398
              ],
              "elements": [
                {
                  "id": "p0334-b6-e3",
                  "class": "small",
                  "text": "詩·鄭風子之丰兮。"
                }
              ]
            },
            {
              "id": "p0334-b6-l4",
              "ord": 4,
              "src": [
                399,
                441
              ],
              "elements": [
                {
                  "id": "p0334-b6-e4",
                  "class": "small",
                  "text": "六書正譌俗作丰，上畫从丿者，非。唐韻敷戎切集韻韻會敷馮切，𠀤音酆。"
                }
              ]
            },
            {
              "id": "p0334-b6-l5",
              "ord": 5,
              "src": [
                442,
                471
              ],
              "elements": [
                {
                  "id": "p0334-b6-e5",
                  "class": "small",
                  "text": "說文豆之豐滿者也。一曰器名，鄕飮酒有豐侯，亦謂之廢禁。"
                }
              ]
            },
            {
              "id": "p0334-b6-l6",
              "ord": 6,
              "src": [
                472,
                483
              ],
              "elements": [
                {
                  "id": "p0334-b6-e6",
                  "class": "small",
                  "text": "陸佃云似豆而𤰞。"
                }
              ]
            },
            {
              "id": "p0334-b6-l7",
              "ord": 7,
              "src": [
                484,
                527
              ],
              "elements": [
                {
                  "id": "p0334-b6-e7",
                  "class": "small",
                  "text": "海錄碎事《射禮》：置豐於西階。古豐國之君以酒亡國，故以爲罰爵，圖其人形於下寓戒也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l8",
              "ord": 8,
              "src": [
                528,
                548
              ],
              "elements": [
                {
                  "id": "p0334-b6-e8",
                  "class": "small",
                  "text": "儀禮·鄕射禮司射適堂西，命弟子設豐。"
                }
              ]
            },
            {
              "id": "p0334-b6-l9",
              "ord": 9,
              "src": [
                549,
                567
              ],
              "elements": [
                {
                  "id": "p0334-b6-e9",
                  "class": "small",
                  "text": "註將飮不勝者，設豐所以承其爵也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l10",
              "ord": 10,
              "src": [
                568,
                600
              ],
              "elements": [
                {
                  "id": "p0334-b6-e10",
                  "class": "small",
                  "text": "疏按《燕禮》君尊有豐，此言承爵豐，則兩用之。又玉篇大也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l11",
              "ord": 11,
              "src": [
                601,
                608
              ],
              "elements": [
                {
                  "id": "p0334-b6-e11",
                  "class": "small",
                  "text": "廣韻多也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l12",
              "ord": 12,
              "src": [
                609,
                639
              ],
              "elements": [
                {
                  "id": "p0334-b6-e12",
                  "class": "small",
                  "text": "易·豐卦疏豐者，多大之名，盈足之義。財多德大，故謂之豐。"
                }
              ]
            },
            {
              "id": "p0334-b6-l13",
              "ord": 13,
              "src": [
                640,
                655
              ],
              "elements": [
                {
                  "id": "p0334-b6-e13",
                  "class": "small",
                  "text": "書·高宗肜日典祀無豐于昵。"
                }
              ]
            },
            {
              "id": "p0334-b6-l14",
              "ord": 14,
              "src": [
                656,
                667
              ],
              "elements": [
                {
                  "id": "p0334-b6-e14",
                  "class": "small",
                  "text": "疏謂犧牲禮物多也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l15",
              "ord": 15,
              "src": [
                668,
                685
              ],
              "elements": [
                {
                  "id": "p0334-b6-e15",
                  "class": "small",
                  "text": "楚語彼若謀楚，其必有豐敗也哉。"
                }
              ]
            },
            {
              "id": "p0334-b6-l16",
              "ord": 16,
              "src": [
                686,
                692
              ],
              "elements": [
                {
                  "id": "p0334-b6-e16",
                  "class": "small",
                  "text": "註大也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l17",
              "ord": 17,
              "src": [
                693,
                755
              ],
              "elements": [
                {
                  "id": "p0334-b6-e17",
                  "class": "small",
                  "text": "揚子·方言凡物之大貌曰豐。又趙魏之郊，燕之北鄙，凡大人謂之豐人。燕記曰：豐人杼首。杼首，長首也。 又廣韻茂也，盛也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l18",
              "ord": 18,
              "src": [
                756,
                767
              ],
              "elements": [
                {
                  "id": "p0334-b6-e18",
                  "class": "small",
                  "text": "詩·小雅在彼豐草。"
                }
              ]
            },
            {
              "id": "p0334-b6-l19",
              "ord": 19,
              "src": [
                768,
                776
              ],
              "elements": [
                {
                  "id": "p0334-b6-e19",
                  "class": "small",
                  "text": "傳豐，茂也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l20",
              "ord": 20,
              "src": [
                777,
                792
              ],
              "elements": [
                {
                  "id": "p0334-b6-e20",
                  "class": "small",
                  "text": "楚語夫事君者，不以豐約舉。"
                }
              ]
            },
            {
              "id": "p0334-b6-l21",
              "ord": 21,
              "src": [
                793,
                811
              ],
              "elements": [
                {
                  "id": "p0334-b6-e21",
                  "class": "small",
                  "text": "註豐，盛。約，衰也。 又猶厚也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l22",
              "ord": 22,
              "src": [
                812,
                840
              ],
              "elements": [
                {
                  "id": "p0334-b6-e22",
                  "class": "small",
                  "text": "周禮·地官·大司徒原隰，其民豐肉而庳。 又歲熟曰豐。"
                }
              ]
            },
            {
              "id": "p0334-b6-l23",
              "ord": 23,
              "src": [
                841,
                854
              ],
              "elements": [
                {
                  "id": "p0334-b6-e23",
                  "class": "small",
                  "text": "詩·周頌豐年多黍多稌。"
                }
              ]
            },
            {
              "id": "p0334-b6-l24",
              "ord": 24,
              "src": [
                855,
                874
              ],
              "elements": [
                {
                  "id": "p0334-b6-e24",
                  "class": "small",
                  "text": "公羊傳·桓三年大有年何，大豐年也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l25",
              "ord": 25,
              "src": [
                875,
                905
              ],
              "elements": [
                {
                  "id": "p0334-b6-e25",
                  "class": "small",
                  "text": "註謂五穀皆大成熟。 又博雅雲師謂之豐隆。一曰雷師也。"
                }
              ]
            },
            {
              "id": "p0334-b6-l26",
              "ord": 26,
              "src": [
                906,
                920
              ],
              "elements": [
                {
                  "id": "p0334-b6-e26",
                  "class": "small",
                  "text": "屈原·離騷吾令豐隆乗雲。"
                }
              ]
            },
            {
              "id": "p0334-b6-l27",
              "ord": 27,
              "src": [
                921,
                940
              ],
              "elements": [
                {
                  "id": "p0334-b6-e27",
                  "class": "small",
                  "text": "淮南子·天文訓季春三月，豐隆乃出。"
                }
              ]
            },
            {
              "id": "p0334-b6-l28",
              "ord": 28,
              "src": [
                941,
                952
              ],
              "elements": [
                {
                  "id": "p0334-b6-e28",
                  "class": "small",
                  "text": "註雷也。 又豐席。"
                }
              ]
            },
            {
              "id": "p0334-b6-l29",
              "ord": 29,
              "src": [
                953,
                1004
              ],
              "elements": [
                {
                  "id": "p0334-b6-e29",
                  "class": "small",
                  "text": "孔安國·書傳豐，莞也。郭璞曰：今西方人呼蒲爲莞，用之爲席。鄭康成曰：刮凍竹席也。 又豐本，韭別名。"
                }
              ]
            },
            {
              "id": "p0334-b6-l30",
              "ord": 30,
              "src": [
                1005,
                1023
              ],
              "elements": [
                {
                  "id": "p0334-b6-e30",
                  "class": "small",
                  "text": "禮·曲禮凡祭宗廟之禮，韭曰豐本。"
                }
              ]
            },
            {
              "id": "p0334-b6-l31",
              "ord": 31,
              "src": [
                1024,
                1039
              ],
              "elements": [
                {
                  "id": "p0334-b6-e31",
                  "class": "small",
                  "text": "註其根本茂盛也。 又地名。"
                }
              ]
            },
            {
              "id": "p0334-b6-l32",
              "ord": 32,
              "src": [
                1040,
                1055
              ],
              "elements": [
                {
                  "id": "p0334-b6-e32",
                  "class": "small",
                  "text": "書·武成王來自商，至于豐。"
                }
              ]
            },
            {
              "id": "p0334-b6-l33",
              "ord": 33,
              "src": [
                1056,
                1087
              ],
              "elements": [
                {
                  "id": "p0334-b6-e33",
                  "class": "small",
                  "text": "傳文王舊都在京兆鄠縣，今長安縣西北是也。通作酆。 又水名。"
                }
              ]
            },
            {
              "id": "p0334-b6-l34",
              "ord": 34,
              "src": [
                1088,
                1099
              ],
              "elements": [
                {
                  "id": "p0334-b6-e34",
                  "class": "small",
                  "text": "詩·大雅豐水東注。"
                }
              ]
            },
            {
              "id": "p0334-b6-l35",
              "ord": 35,
              "src": [
                1100,
                1132
              ],
              "elements": [
                {
                  "id": "p0334-b6-e35",
                  "class": "small",
                  "text": "後漢·郡國志註豐水出鄠南山豐谷，北入于渭。通作灃。 又縣名。"
                }
              ]
            },
            {
              "id": "p0334-b6-l36",
              "ord": 36,
              "src": [
                1133,
                1206
              ],
              "elements": [
                {
                  "id": "p0334-b6-e36",
                  "class": "small",
                  "text": "前漢·地理志豐縣，屬沛郡。 又州名。古太原郡，宋置豐州。又陝西，隋置豐州。 又山名。豐山，在滁州南二里許，上有豐樂亭。見歐陽修記。又人名。"
                }
              ]
            },
            {
              "id": "p0334-b6-l37",
              "ord": 37,
              "src": [
                1207,
                1227
              ],
              "elements": [
                {
                  "id": "p0334-b6-e37",
                  "class": "small",
                  "text": "前漢·古今人表𨻰豐，帝嚳妃，生堯。"
                }
              ]
            },
            {
              "id": "p0334-b6-l38",
              "ord": 38,
              "src": [
                1228,
                1243
              ],
              "elements": [
                {
                  "id": "p0334-b6-e38",
                  "class": "small",
                  "text": "師古曰卽𨻰鋒也。 又姓。"
                }
              ]
            },
            {
              "id": "p0334-b6-l39",
              "ord": 39,
              "src": [
                1244,
                1281
              ],
              "elements": [
                {
                  "id": "p0334-b6-e39",
                  "class": "small",
                  "text": "廣韻鄭穆公子豐之後。又複姓。豐將氏。見潛夫論。 又叶敷文切，音分。"
                }
              ]
            },
            {
              "id": "p0334-b6-l40",
              "ord": 40,
              "src": [
                1282,
                1318
              ],
              "elements": [
                {
                  "id": "p0334-b6-e40",
                  "class": "small",
                  "text": "蔡邕·𥓓民安物豐。上叶綏我荆衡，下叶以紀洪勳。 又叶敷康切，音芳。"
                }
              ]
            },
            {
              "id": "p0334-b6-l41",
              "ord": 41,
              "src": [
                1319,
                1351
              ],
              "elements": [
                {
                  "id": "p0334-b6-e41",
                  "class": "small",
                  "text": "韓愈·歐陽生哀辭友則旣獲兮，祿實不豐。以志爲養兮，何有牛羊。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0334-b7",
          "ord": 7,
          "src": [
            1353,
            1355
          ],
          "lines": [
