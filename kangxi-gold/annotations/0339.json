              ],
              "elements": [
                {
                  "id": "p0339-b4-e1",
                  "class": "small",
                  "text": "納新爲內丹。黃庭經九轉八瓊丹。註八者：朱砂，雄黃，空靑，硫黃，"
                }
              ]
            }
