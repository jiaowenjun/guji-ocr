              ],
              "elements": [
                {
                  "id": "p0339-b16-e0",
                  "class": "small",
                  "text": "註八者：朱砂，雄黃，空靑，硫黃，"
                }
              ]
            },
            {
              "id": "p0339-b16-l1",
              "ord": 1,
              "src": [
                597,
                629
              ],
              "elements": [
                {
                  "id": "p0339-b16-e1",
                  "class": "small",
                  "text": "雲母，戎鹽，硝石，雌黃也。 又博物志和氣相感，則陵出黑丹。仁"
                }
              ]
            },
            {
              "id": "p0339-b16-l2",
              "ord": 2,
              "src": [
                630,
                654
              ],
              "elements": [
                {
                  "id": "p0339-b16-e2",
                  "class": "small",
                  "text": "主壽昌，民延壽命，天下太平。 又以朱色塗物曰丹。"
                }
              ]
            }
          ]
        },
        {
          "id": "p0339-b17",
          "ord": 17,
