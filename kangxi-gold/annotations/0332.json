              ],
              "elements": [
                {
                  "id": "p0332-b1-e1",
                  "class": "small",
                  "text": "誥王來紹上帝，自服于土中。註洛爲天地之中。張衡·東京賦宅"
                }
              ]
            }
          ]
        },
        {
          "id": "p0332-b2",
          "ord": 2,
          "src": [
